{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

<section class="cp-section cp-bestsellers" id="cp-bestsellers">
  <div class="cp-wrap">
    <div class="cp-section-header">
      <div>
        <div class="cp-eyebrow" style="margin-bottom:8px">Top picks</div>
        <h2 class="cp-section-header__h2">{{ section.settings.heading | default: "Canada's best-loved proteins" }}</h2>
      </div>
      <a href="{{ section.settings.view_all_url | default: '/collections/best-selling-collection' }}" class="cp-section-header__all">
        Shop all
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="cp-bestsellers__grid">
      {%- for block in section.blocks -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- unless p == blank -%}
          {%- render 'cp-product-card', product: p, compact: true, highlight: false, section_settings: section.settings -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CP Best Sellers",
  "settings": [
    { "type": "text",    "id": "heading",      "label": "Section heading",    "default": "Canada's best-loved proteins" },
    { "type": "url",     "id": "view_all_url", "label": "View all link" },
    { "type": "select",  "id": "card_density", "label": "Card density",
      "options": [
        { "value": "lean", "label": "Lean (compact)" },
        { "value": "rich", "label": "Rich (macros visible)" }
      ],
      "default": "lean"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CP Best Sellers",
      "blocks": [
        { "type": "product", "settings": { "product": "whey-protein-concentrate" } },
        { "type": "product", "settings": { "product": "100-whey-protein-isolate" } },
        { "type": "product", "settings": { "product": "iso90" } },
        { "type": "product", "settings": { "product": "economy-whey" } }
      ]
    }
  ]
}
{% endschema %}
