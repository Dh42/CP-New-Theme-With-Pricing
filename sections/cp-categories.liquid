{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

<section class="cp-section cp-categories" id="cp-categories">
  <div class="cp-wrap">
    <div class="cp-section-header">
      <div>
        <div class="cp-eyebrow" style="margin-bottom:8px">Browse by category</div>
        <h2 class="cp-section-header__h2">{{ section.settings.heading | default: "Shop by category" }}</h2>
      </div>
    </div>

    <div class="cp-categories__grid">
      {%- for block in section.blocks -%}
        {%- assign cat_collection = collections[block.settings.collection] -%}
        <a href="{{ block.settings.url | default: cat_collection.url | default: '#' }}"
           class="cp-cat"
           data-block-id="{{ block.id }}">
          {%- if block.settings.image != blank -%}
            <img class="cp-cat__img"
              src="{{ block.settings.image | image_url: width: 600 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
              sizes="(max-width:860px) 50vw, 20vw"
              alt="{{ block.settings.label | escape }}"
              loading="lazy">
          {%- elsif cat_collection.image != blank -%}
            <img class="cp-cat__img"
              src="{{ cat_collection.image | image_url: width: 600 }}"
              alt="{{ cat_collection.title | escape }}"
              loading="lazy">
          {%- else -%}
            <div class="cp-cat__img cp-cat__img--placeholder"></div>
          {%- endif -%}
          <div class="cp-cat__overlay"></div>
          <div class="cp-cat__body">
            <span class="cp-cat__label">{{ block.settings.label | default: cat_collection.title }}</span>
            {%- if block.settings.sublabel != blank -%}
              <span class="cp-cat__sub">{{ block.settings.sublabel }}</span>
            {%- endif -%}
            <span class="cp-cat__arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CP Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        { "type": "collection",   "id": "collection", "label": "Collection (for image & URL fallback)" },
        { "type": "url",          "id": "url",         "label": "Override URL" },
        { "type": "text",         "id": "label",       "label": "Label" },
        { "type": "text",         "id": "sublabel",    "label": "Sublabel (optional)" },
        { "type": "image_picker", "id": "image",       "label": "Override image (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CP Categories",
      "blocks": [
        { "type": "category", "settings": { "label": "Whey Protein", "collection": "protein-powders", "sublabel": "Build & recover" } },
        { "type": "category", "settings": { "label": "Best Sellers", "collection": "best-selling-collection", "sublabel": "Community favourites" } },
        { "type": "category", "settings": { "label": "Supplements",  "collection": "supplements", "sublabel": "Creatine, vitamins & more" } },
        { "type": "category", "settings": { "label": "Vegan",        "collection": "vegan", "sublabel": "Plant-based proteins" } },
        { "type": "category", "settings": { "label": "Bulk Value",   "collection": "bulk-protein", "sublabel": "Stock up & save" } }
      ]
    }
  ]
}
{% endschema %}
