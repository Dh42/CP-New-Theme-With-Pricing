{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

<section class="cp-section cp-compare" id="cp-compare">
  <div class="cp-wrap">
    <div class="cp-compare__intro">
      <div class="cp-eyebrow" style="margin-bottom:12px">Find your match</div>
      <h2 class="cp-compare__h2">{{ section.settings.heading | default: 'Which whey is right for you?' }}</h2>
      <p class="cp-compare__sub">{{ section.settings.subtext | default: 'Compare our four most-loved formulas — or let us pick for you in 30 seconds.' }}</p>
      <a href="#cp-quiz" class="cp-compare__quiz-btn" data-scroll-to="cp-quiz">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7z"/></svg>
        Take the 30-second quiz
      </a>
    </div>
  </div>

  <div class="cp-wrap cp-compare__grid">
    {%- for block in section.blocks -%}
      {%- assign prod = all_products[block.settings.product] -%}
      {%- unless prod == blank -%}
        {%- render 'cp-product-card',
          product: prod,
          compact: false,
          highlight: block.settings.is_highlighted,
          badge_text: block.settings.badge_text,
          badge_color: block.settings.badge_color,
          badge_text_color: block.settings.badge_text_color,
          use_line: block.settings.use_line,
          subscribe_save_text: section.settings.subscribe_save_text,
          section_settings: section.settings
        -%}
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

<style>
  @media (max-width: 860px) {
    #cp-compare .cp-compare__grid {
      display: flex !important;
      flex-wrap: nowrap;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 28px 20px 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg,#000 92%,transparent 100%);
      mask-image: linear-gradient(90deg,#000 92%,transparent 100%);
      margin-top: 14px;
      grid-template-columns: unset;
    }
    #cp-compare .cp-compare__grid::-webkit-scrollbar { display: none; }
    #cp-compare .cp-compare__grid > * {
      flex: 0 0 85%;
      scroll-snap-align: start;
      max-width: 340px;
    }
  }
</style>

{% schema %}
{
  "name": "CP Comparison Grid",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Section heading", "default": "Which whey is right for you?" },
    { "type": "textarea", "id": "subtext",    "label": "Section subtext", "default": "Compare our four most-loved formulas — or let us pick for you in 30 seconds." },
    { "type": "text",     "id": "subscribe_save_text", "label": "Subscribe & save line", "default": "Subscribe & save an extra 30%" },
    {
      "type": "select",
      "id": "card_density",
      "label": "Card density",
      "options": [
        { "value": "rich", "label": "Rich (macros + features)" },
        { "value": "lean", "label": "Lean (features only)" }
      ],
      "default": "rich"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "header",  "content": "Callout badge" },
        { "type": "text",    "id": "badge_text",       "label": "Badge text (leave blank to hide)" },
        { "type": "color",   "id": "badge_color",      "label": "Badge background colour", "default": "#D81E2B" },
        { "type": "color",   "id": "badge_text_color", "label": "Badge text colour",       "default": "#ffffff" },
        { "type": "header",  "content": "Card details" },
        { "type": "text",    "id": "use_line",         "label": "Use line (e.g. Most popular all-rounder)" },
        { "type": "checkbox","id": "is_highlighted",   "label": "Highlight this card", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "CP Comparison Grid",
    "blocks": [
      { "type": "product_card", "settings": { "badge_text": "Best Seller", "badge_color": "#D81E2B", "badge_text_color": "#ffffff", "use_line": "Most popular all-rounder", "is_highlighted": true } },
      { "type": "product_card", "settings": { "badge_text": "Lean Pick",   "badge_color": "#111113", "badge_text_color": "#ffffff", "use_line": "Leanest macros, low lactose",  "is_highlighted": false } },
      { "type": "product_card", "settings": { "badge_text": "Premium",     "badge_color": "#0E76C4", "badge_text_color": "#ffffff", "use_line": "Premium isolate + collagen",   "is_highlighted": false } },
      { "type": "product_card", "settings": { "badge_text": "Best Value",  "badge_color": "#1F8A4C", "badge_text_color": "#ffffff", "use_line": "Lowest cost per serving",      "is_highlighted": false } }
    ]
  }]
}
{% endschema %}
