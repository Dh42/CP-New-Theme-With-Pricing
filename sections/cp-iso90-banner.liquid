{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

{%- assign iso90 = all_products['iso90'] -%}

<section class="cp-section cp-iso90" id="cp-iso90">
  <div class="cp-wrap cp-iso90__inner">
    <div class="cp-iso90__content">
      <div class="cp-iso90__eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.9 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
        {{ section.settings.eyebrow | default: 'New — Premium formula' }}
      </div>
      <h2 class="cp-iso90__h2">{{ section.settings.heading | default: 'Meet Iso90' }}</h2>
      <p class="cp-iso90__sub">{{ section.settings.subtext | default: '90% protein by weight. Whey isolate fortified with collagen — for athletes who demand the leanest macros and fastest recovery.' }}</p>

      <ul class="cp-iso90__features">
        {%- for block in section.blocks -%}
          <li class="cp-iso90__feature" {{ block.shopify_attributes }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>

      <div class="cp-iso90__actions">
        <a href="{{ section.settings.cta_link | default: iso90.url | default: '/products/iso90' }}" class="cp-btn-primary">
          {{ section.settings.cta_label | default: 'Try Iso90' }}
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <div class="cp-iso90__visual">
      {%- if section.settings.image != blank -%}
        <img class="cp-iso90__img"
          src="{{ section.settings.image | image_url: width: 640 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 640 }} 640w"
          sizes="(max-width:860px) 100vw, 40vw"
          alt="{{ section.settings.heading | default: 'Iso90' | escape }}"
          loading="lazy">
      {%- elsif iso90 != blank and iso90.featured_image != blank -%}
        <img class="cp-iso90__img"
          src="{{ iso90.featured_image | image_url: width: 640 }}"
          alt="{{ iso90.title | escape }}"
          loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CP Iso90 Banner",
  "settings": [
    { "type": "text",         "id": "eyebrow",   "label": "Eyebrow label",  "default": "New — Premium formula" },
    { "type": "text",         "id": "heading",   "label": "Heading",        "default": "Meet Iso90" },
    { "type": "textarea",     "id": "subtext",   "label": "Body text" },
    { "type": "text",         "id": "cta_label", "label": "CTA label",      "default": "Try Iso90" },
    { "type": "url",          "id": "cta_link",  "label": "CTA link override" },
    { "type": "image_picker", "id": "image",     "label": "Product image (uses Iso90 product image if blank)" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "text", "label": "Feature text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CP Iso90 Banner",
      "blocks": [
        { "type": "feature", "settings": { "text": "90% protein by weight" } },
        { "type": "feature", "settings": { "text": "Fortified with collagen peptides" } },
        { "type": "feature", "settings": { "text": "Virtually no lactose or fat" } },
        { "type": "feature", "settings": { "text": "Made in Windsor, Ontario" } }
      ]
    }
  ]
}
{% endschema %}
