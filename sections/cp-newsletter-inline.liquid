{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

<section class="cp-section cp-newsletter" id="cp-newsletter">
  <div class="cp-wrap cp-newsletter__inner">
    <div class="cp-newsletter__text">
      <h2 class="cp-newsletter__h2">{{ section.settings.heading | default: 'Join 100,000+ Canadians' }}</h2>
      <p class="cp-newsletter__sub">{{ section.settings.subtext | default: 'Exclusive deals, new flavours, and no-BS nutrition tips — delivered when it matters.' }}</p>
      <div class="cp-newsletter__perks">
        <span class="cp-newsletter__perk">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          10% off your first order
        </span>
        <span class="cp-newsletter__perk">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          Early access to new drops
        </span>
        <span class="cp-newsletter__perk">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          No spam, ever
        </span>
      </div>
    </div>
    <div class="cp-newsletter__form-wrap">
      {%- form 'customer', id: 'cp-nl-form', class: 'cp-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <div class="cp-newsletter__field-group">
          <input class="cp-newsletter__input" type="email" name="contact[email]"
            id="cp-nl-email"
            placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
            autocomplete="email"
            required
            aria-label="Email address">
          <button class="cp-newsletter__submit cp-btn-primary" type="submit">
            {{ section.settings.submit_label | default: 'Get 10% Off' }}
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <p class="cp-newsletter__fine">By subscribing you agree to our
          <a href="/policies/privacy-policy" style="color:inherit;opacity:.7">Privacy Policy</a>.
          Unsubscribe any time.
        </p>
        {%- if form.posted_successfully? -%}
          <div class="cp-newsletter__success" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
            {{ section.settings.success_msg | default: "You're in! Check your inbox for your 10% off code." }}
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="cp-newsletter__error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CP Newsletter",
  "settings": [
    { "type": "text",     "id": "heading",      "label": "Heading",           "default": "Join 100,000+ Canadians" },
    { "type": "textarea", "id": "subtext",      "label": "Subtext" },
    { "type": "text",     "id": "placeholder",  "label": "Input placeholder", "default": "Your email address" },
    { "type": "text",     "id": "submit_label", "label": "Submit button text","default": "Get 10% Off" },
    { "type": "text",     "id": "success_msg",  "label": "Success message",   "default": "You're in! Check your inbox for your 10% off code." }
  ],
  "presets": [{ "name": "CP Newsletter" }]
}
{% endschema %}
