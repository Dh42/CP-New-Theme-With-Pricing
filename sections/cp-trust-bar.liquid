{{ 'cp-homepage.css' | asset_url | stylesheet_tag }}

<section class="cp-section cp-trust-bar">
  <div class="cp-wrap cp-trust-bar__grid">
    {%- for block in section.blocks -%}
      <div class="cp-trust-bar__item" {{ block.shopify_attributes }}>
        <span class="cp-trust-bar__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h15v13H1zM16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- when 'flask' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 14h9"/></svg>
            {%- when 'maple' -%}
              <svg width="22" height="22" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 24l-22 78c-3 11-15 9-24 4l-34-19 25 140c5 26-12 26-20 15l-59-69-10 35c-2 8-7 11-14 9l-75-16 20 75c4 17 7 23-4 28l-13 5 129 109c8 6 7 11 6 18l-11 39 128-15c4 0 11 3 10 8l-6 142h32l-3-142c0-5 6-9 10-8l128 15-11-39c-2-7-2-12 6-18l129-109-13-5c-12-5-9-11-5-28l20-75-75 16c-7 2-12-1-14-9l-10-35-59 69c-8 11-25 11-20-15l25-140-34 19c-9 5-21 7-24-4z"/></svg>
            {%- when 'shield' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'star' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.9 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
            {%- when 'check' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'clock' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {%- when 'heart' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
            {%- when 'box' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            {%- when 'refresh' -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.5 7A9 9 0 0 0 5.2 5.2L1 10M23 14l-4.2 4.8A9 9 0 0 1 3.5 17"/></svg>
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
          {%- endcase -%}
        </span>
        <div>
          <div class="cp-trust-bar__title">{{ block.settings.title }}</div>
          {%- if block.settings.subtitle != blank -%}
            <div class="cp-trust-bar__sub">{{ block.settings.subtitle }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "CP Trust Bar",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck",   "label": "Truck / Shipping" },
            { "value": "flask",   "label": "Flask / Lab tested" },
            { "value": "maple",   "label": "Maple leaf / Canada" },
            { "value": "shield",  "label": "Shield / Guarantee" },
            { "value": "star",    "label": "Star / Award" },
            { "value": "check",   "label": "Checkmark / Certified" },
            { "value": "clock",   "label": "Clock / Speed" },
            { "value": "heart",   "label": "Heart / Care" },
            { "value": "box",     "label": "Box / Packaging" },
            { "value": "refresh", "label": "Refresh / Returns" }
          ],
          "default": "check"
        },
        { "type": "text",     "id": "title",    "label": "Title",    "default": "Trust signal" },
        { "type": "text",     "id": "subtitle", "label": "Subtitle (optional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "CP Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck",  "title": "Free Shipping",         "subtitle": "On Canadian orders over $99" } },
        { "type": "item", "settings": { "icon": "flask",  "title": "Batch-Tested for Purity","subtitle": "Every lot lab-verified for quality" } },
        { "type": "item", "settings": { "icon": "maple",  "title": "Made in Canada",         "subtitle": "Crafted in Windsor, Ontario" } }
      ]
    }
  ]
}
{% endschema %}
