  <script>
    const prevButton = document.querySelector('.prev-slide');
        const nextButton = document.querySelector('.next-slide');
        const videoList = document.querySelector('.video-list');
        const videos = document.querySelectorAll('.video-item video');

        let videoWidth = videoList.scrollWidth / videoList.children.length;

        prevButton.addEventListener('click', () => {
            videoList.scrollLeft -= videoWidth; // Adjust according to video width

            // Loop to the end if scrolled to the beginning
            if (videoList.scrollLeft === 0) {
                videoList.scrollLeft = videoList.scrollWidth - videoList.clientWidth;
            }
        });

        nextButton.addEventListener('click', () => {
            videoList.scrollLeft += videoWidth; // Adjust according to video width

            // Loop to the beginning if scrolled to the end or very close to the end
            if (videoList.scrollLeft + videoList.clientWidth + 1 >= videoList.scrollWidth) {
                videoList.scrollLeft = 0;
            }
        });


        videos.forEach(video => {
            // Hide controls by default
            video.controls = false;

            // Show controls on hover
            video.addEventListener('mouseenter', () => {
                video.controls = true;
            });

            // Hide controls when not hovering
            video.addEventListener('mouseleave', () => {
                video.controls = false;
            });

            // Toggle play/pause on click
            video.addEventListener('click', (e) => {
                if (video.paused) {
                    video.play();
                } else {
                    video.pause();
                }
                // Prevent default behavior for click events to avoid interference with play/pause
                e.preventDefault();
            });
        });
        videos.forEach(video => {
            // Toggle play/pause on tap for touchscreen devices
            video.addEventListener('touchstart', (e) => {
                if (video.paused) {
                    video.play();
                } else {
                    video.pause();
                }
                // Show controls on tap
                video.controls = true;
                // Prevent default behavior for touch events to avoid interference with play/pause
                e.preventDefault();
            });
        });
        // Safari-specific behavior to play the video when clicked or tapped
        const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
        if (isSafari) {
            videos.forEach(video => {
                video.addEventListener('click', () => {
                    if (video.paused) {
                        video.play();
                    } else {
                        video.pause();
                    }
                });
            });
