{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "hdt-slideshow hdt-section section-allow-transparent",
  "disabled_on": {
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.slideshow.settings.layout.options.full_width.label",
      "default": false
    },
    {
      "type": "select",
      "id": "item_round",
      "label": "t:sections.slideshow.settings.rounded.label",
      "options": [
        {
          "value": "rounded",
          "label": "t:sections.slideshow.settings.rounded.options.option_1"
        },
        {
          "value": "rounded-lg",
          "label": "t:sections.slideshow.settings.rounded.options.option_2"
        }
      ],
      "default": "rounded",
      "info": "Only work if section not full width"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_1"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt_image_first",
          "label": "t:sections.slideshow.settings.image_height.adapt_image_first"
        },
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.image_height.adapt_image"
        },
        {
          "value": "full",
          "label": "t:sections.slideshow.settings.image_height.full"
        },
        {
          "value": "fixed",
          "label": "t:sections.slideshow.settings.image_height.fixed"
        }
      ],
      "default": "adapt_image",
      "label": "t:sections.slideshow.settings.image_height.label",
      "info": "t:sections.slideshow.settings.image_height.info"
    },
    {
      "type": "range",
      "id": "fixed_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "t:sections.slideshow.settings.image_height.fixed",
      "default": 860
    },
    {
      "type": "select",
      "id": "image_height_mb",
      "options": [
        {
          "value": "adapt_image_first",
          "label": "t:sections.slideshow.settings.image_height.adapt_image_first"
        },
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.image_height.adapt_image"
        },
        {
          "value": "full",
          "label": "t:sections.slideshow.settings.image_height.full"
        },
        {
          "value": "fixed",
          "label": "t:sections.slideshow.settings.image_height.fixed"
        }
      ],
      "default": "adapt_image",
      "label": "t:sections.slideshow.settings.image_height.label_2"
    },
    {
      "type": "range",
      "id": "fixed_height_mb",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "t:sections.slideshow.settings.image_height.fixed_2",
      "default": 300
    },
