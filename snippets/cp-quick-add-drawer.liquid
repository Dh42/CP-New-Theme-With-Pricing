<div class="cp-qa-overlay" id="cp-qa-overlay" aria-hidden="true" role="dialog" aria-label="Quick Add" aria-modal="true">
  <button class="cp-qa-backdrop" type="button" tabindex="-1" aria-label="Close"></button>
  <div class="cp-qa-drawer">

    <div class="cp-qa-header">
      <span class="cp-qa-title">Quick Add</span>
      <button class="cp-qa-close" type="button" aria-label="Close quick add">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="cp-qa-scroll">
      {%- comment -%}cp-homepage.js renders product image, flavour chips, size buttons, purchase options, and qty here.{%- endcomment -%}
    </div>

    <div class="cp-qa-footer" style="display:none">
      <div class="cp-qa-total">
        <span class="cp-qa-summary"></span>
        <span class="cp-qa-price-total"></span>
      </div>
      <button class="cp-qa-add-btn" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        Add to cart
      </button>
      <button class="cp-qa-notify-btn sc-back-in-stock-button" type="button" hidden data-variant-id="">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        Notify Me When Back In Stock
      </button>
      <div class="cp-qa-trust">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
        Free shipping on orders over $99
      </div>
      <div class="cp-qa-error" role="alert"></div>
    </div>

  </div>
</div>
