{%- comment -%}
  cp-sale-metafield-price.liquid
  Reads variant metafield custom.sale_percentage (integer, e.g. 15 = 15% off).
  If set, overrides the displayed price with the discounted amount and shows the
  original Shopify price as a strikethrough compare-at — matching what the
  automatic discount will charge in the cart.
  Uses MutationObserver to hold the discount in place against any theme re-renders.
{%- endcomment -%}

{%- liquid
  assign cp_init_variant = product.selected_or_first_available_variant
  assign cp_init_sale_pct = cp_init_variant.metafields.custom.sale_percentage | plus: 0
-%}

<script>
  window['cpSaleActive_{{ product.id }}'] = {{ cp_init_sale_pct > 0 }};
</script>

<script type="application/json" id="cp-sale-data-{{ product.id }}">
{
  "variants": {
    {%- for v in product.variants -%}
      {%- assign sale_pct = v.metafields.custom.sale_percentage | plus: 0 -%}
      {%- assign remaining_pct = 100 | minus: sale_pct -%}
      {%- assign discounted_cents = v.price | times: remaining_pct | divided_by: 100 -%}
      {%- if settings.currency_code_enabled -%}
        {%- assign cp_orig = v.price | money_with_currency | strip_html -%}
        {%- assign cp_disc = discounted_cents | money_with_currency | strip_html -%}
      {%- else -%}
        {%- assign cp_orig = v.price | money | strip_html -%}
        {%- assign cp_disc = discounted_cents | money | strip_html -%}
      {%- endif -%}
      "{{ v.id }}": {
        "salePercent": {{ sale_pct }},
        "originalFormatted": {{ cp_orig | json }},
        "discountedFormatted": {% if sale_pct > 0 %}{{ cp_disc | json }}{% else %}""{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
}
</script>

<script>
(function () {
  var productId = '{{ product.id }}';
  var saleFlag  = 'cpSaleActive_' + productId;

  var dataEl = document.getElementById('cp-sale-data-' + productId);
  if (!dataEl) return;

  var variantData;
  try { variantData = JSON.parse(dataEl.textContent).variants; } catch (e) { return; }

  // Active MutationObservers — disconnected and replaced on every variant change.
  var activeObservers = [];
  var currentData = null;

  function disconnectAll() {
    activeObservers.forEach(function (o) { o.disconnect(); });
    activeObservers = [];
  }

  // Watch a single element. When anything changes it away from `expected`,
  // immediately restore it. Uses disconnect/reconnect to avoid triggering itself.
  function watchText(el, expected, onRestore) {
    var obs = new MutationObserver(function () {
      if (el.textContent === expected) return;
      obs.disconnect();
      el.textContent = expected;
      if (onRestore) onRestore();
      setTimeout(function () {
        obs.observe(el, { childList: true, subtree: true, characterData: true });
      }, 0);
    });
    obs.observe(el, { childList: true, subtree: true, characterData: true });
    activeObservers.push(obs);
  }

  // Watch for the hidden attribute being re-added to compareEl.
  function watchHidden(compareEl, originalText) {
    var obs = new MutationObserver(function () {
      if (!compareEl.hasAttribute('hidden')) return;
      obs.disconnect();
      compareEl.removeAttribute('hidden');
      var cm = compareEl.querySelector('.hdt-money');
      if (cm && currentData) cm.textContent = currentData.originalFormatted;
      setTimeout(function () {
        obs.observe(compareEl, { attributes: true, attributeFilter: ['hidden'] });
      }, 0);
    });
    obs.observe(compareEl, { attributes: true, attributeFilter: ['hidden'] });
    activeObservers.push(obs);
  }

  function applyDiscount(variantId) {
    disconnectAll();

    var data = variantData[String(variantId)];
    if (!data) return;

    window[saleFlag] = data.salePercent > 0;
    currentData = data;

    if (data.salePercent <= 0 || !data.discountedFormatted) {
      // No sale on this variant — clear any overrides we set
      document.querySelectorAll('.hdt-product__price, .cp-mobile-price').forEach(function (container) {
        var priceEl   = container.querySelector('hdt-price');
        var compareEl = container.querySelector('hdt-compare-at-price');
        if (priceEl && priceEl.dataset.cpSaleOverride) delete priceEl.dataset.cpSaleOverride;
        if (compareEl && compareEl.dataset.cpSaleOverride) {
          compareEl.setAttribute('hidden', '');
          delete compareEl.dataset.cpSaleOverride;
        }
      });
      return;
    }

    document.querySelectorAll('.hdt-product__price, .cp-mobile-price').forEach(function (container) {
      var priceEl   = container.querySelector('hdt-price');
      var compareEl = container.querySelector('hdt-compare-at-price');
      if (!priceEl) return;

      var moneyEl = priceEl.querySelector('.hdt-money');
      if (!moneyEl) return;

      // Apply immediately
      moneyEl.textContent = data.discountedFormatted;
      priceEl.dataset.cpSaleOverride = '1';

      if (compareEl) {
        var compareMoneyEl = compareEl.querySelector('.hdt-money');
        if (compareMoneyEl) compareMoneyEl.textContent = data.originalFormatted;
        compareEl.removeAttribute('hidden');
        compareEl.dataset.cpSaleOverride = '1';

        // Hold the compare-at text in place
        if (compareMoneyEl) {
          watchText(compareMoneyEl, data.originalFormatted);
        }
        // Re-show if the element gets hidden again
        watchHidden(compareEl, data.originalFormatted);
      }

      // Hold the discounted price in place against any theme re-renders
      watchText(moneyEl, data.discountedFormatted, function () {
        // Also restore compare-at whenever hdt-price overwrites the main price
        if (compareEl) {
          var cm = compareEl.querySelector('.hdt-money');
          if (cm && currentData) cm.textContent = currentData.originalFormatted;
          compareEl.removeAttribute('hidden');
        }
      });
    });
  }

  function currentVariantId() {
    var f  = document.querySelector('form[action^="/cart/add"]');
    var el = f && f.querySelector('[name="id"]');
    return el ? el.value : null;
  }

  // Set the global flag synchronously on variant:change so updateMainPrice()
  // in main-product.liquid (which fires at 50ms) sees it before it runs.
  document.addEventListener('variant:change', function (e) {
    if (!(e.detail && e.detail.variant)) return;
    var vData = variantData[String(e.detail.variant.id)];
    window[saleFlag] = !!(vData && vData.salePercent > 0);
    applyDiscount(String(e.detail.variant.id));
  });

  document.addEventListener('change', function (e) {
    var form = e.target.closest && e.target.closest('form[action^="/cart/add"]');
    if (!form) return;
    var id = currentVariantId();
    if (!id) return;
    var vData = variantData[String(id)];
    window[saleFlag] = !!(vData && vData.salePercent > 0);
    applyDiscount(String(id));
  });

  function init() {
    var id = currentVariantId();
    if (id) applyDiscount(String(id));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
