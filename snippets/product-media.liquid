{%- comment -%}
  Renders product media list.
  Accepts:
  - product: {Object} product object.
  - class: {String} a class list
  - un_no_pick
  - selected_variant

  Usage:
  {%- render 'product-media' -%}
{%- endcomment -%}

{%- liquid
  #assign selected_variant = product.selected_or_first_available_variant
  assign selected_variant_featured_media = selected_variant.featured_media
  assign group_media_obj = product.metafields.theme.group_media_obj.value
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign desktop_media_layout = section.settings.desktop_media_layout
  assign mobile_media_layout = section.settings.mobile_media_layout
  if product.media.size < 1
    assign desktop_media_layout = 'no_media_size'
  elsif product.media.size == 1
    assign desktop_media_layout = 'one_media_size'
  endif
  if desktop_media_layout == '2_columns'
    assign desktop_columns = 2
  else
    assign desktop_columns = 1
  endif
  if mobile_media_layout == '2_columns'
    assign mobile_columns = 2
  else
    assign mobile_columns = 1
  endif
  if section.settings.image != blank
    assign desktop_media_layout = 'no_media_size'
  endif
  assign media_width = section.settings.media_width | divided_by: 100.0
  assign models = product.media | where: 'media_type', 'model'
  assign first_3d_model = models | first
  assign cp_img_front = product.metafields.custom.front_image
  assign cp_img_back = product.metafields.custom.back_image
  assign cp_img_scoop = product.metafields.custom.scoop_image
  assign cp_img_lifestyle = product.metafields.custom.lifestyle_image
  assign cp_has_all_images = false
  if cp_img_front != blank and cp_img_back != blank and cp_img_scoop != blank and cp_img_lifestyle != blank
    assign cp_has_all_images = true
  endif
-%}

{%- capture sizes -%}
  (min-width: 1150px) {{ settings.page_width | minus: 100 | times: media_width | divided_by: desktop_columns | round }}px, (min-width: 768px) calc((100vw - 10rem) / 2), calc(100vw / {{ mobile_columns }} - 4rem)
{%- endcapture -%}

{%- if first_3d_model -%}
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'; this.onload = null">
{%- endif -%}

{% comment %} nemo {% endcomment %}

{% assign v = product.selected_or_first_available_variant %}
{% assign nutrition = v.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant.value %}
{% assign initial_serving_size = nutrition.ssize | plus: 0 %}
{% assign initial_container_grams = 0 %}
{% if v.option1 contains '10 kg' or v.option2 contains '10 kg' or v.option3 contains '10 kg' or v.title contains '10 kg' %}
  {% assign initial_container_grams = 10000 %}
{% elsif v.option1 contains '6 kg' or v.option2 contains '6 kg' or v.option3 contains '6 kg' or v.title contains '6 kg' %}
  {% assign initial_container_grams = 6000 %}
{% elsif v.option1 contains '2 kg' or v.option2 contains '2 kg' or v.option3 contains '2 kg' or v.title contains '2 kg' %}
  {% assign initial_container_grams = 2000 %}
{% elsif v.option1 contains '1 kg' or v.option2 contains '1 kg' or v.option3 contains '1 kg' or v.title contains '1 kg' %}
  {% assign initial_container_grams = 1000 %}
{% elsif v.option1 contains '454 g' or v.option2 contains '454 g' or v.option3 contains '454 g' or v.title contains '454 g' %}
  {% assign initial_container_grams = 454 %}
{% elsif v.option1 contains '100 g' or v.option2 contains '100 g' or v.option3 contains '100 g' or v.title contains '100 g' %}
  {% assign initial_container_grams = 100 %}
{% endif %}
{% assign initial_servings = nutrition.servingsPerContainer | round %}
{% if initial_serving_size > 0 and initial_container_grams > 0 %}
  {% assign initial_servings = initial_container_grams | divided_by: initial_serving_size | round %}
{% endif %}
{% assign initial_cost_cents = 0 %}
{% if initial_servings > 0 %}
  {% assign initial_cost_cents = v.price | times: 1.0 | divided_by: initial_servings | round %}
{% endif %}

<div id="nutrition-data" data-product-form="{{ product_form_id }}" style="display:none;">
  {% for variant in product.variants %}
    {% assign n = variant.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant.value %}
    {% assign container_grams = 0 %}
    {% if variant.option1 contains '10 kg' or variant.option2 contains '10 kg' or variant.option3 contains '10 kg' or variant.title contains '10 kg' %}
      {% assign container_grams = 10000 %}
    {% elsif variant.option1 contains '6 kg' or variant.option2 contains '6 kg' or variant.option3 contains '6 kg' or variant.title contains '6 kg' %}
      {% assign container_grams = 6000 %}
    {% elsif variant.option1 contains '2 kg' or variant.option2 contains '2 kg' or variant.option3 contains '2 kg' or variant.title contains '2 kg' %}
      {% assign container_grams = 2000 %}
    {% elsif variant.option1 contains '1 kg' or variant.option2 contains '1 kg' or variant.option3 contains '1 kg' or variant.title contains '1 kg' %}
      {% assign container_grams = 1000 %}
    {% elsif variant.option1 contains '454 g' or variant.option2 contains '454 g' or variant.option3 contains '454 g' or variant.title contains '454 g' %}
      {% assign container_grams = 454 %}
    {% elsif variant.option1 contains '100 g' or variant.option2 contains '100 g' or variant.option3 contains '100 g' or variant.title contains '100 g' %}
      {% assign container_grams = 100 %}
    {% endif %}
    {% if n %}
      {%- assign _sub_price = variant.price -%}
      {%- for allocation in variant.selling_plan_allocations -%}
        {%- assign _sub_price = allocation.price -%}
        {%- break -%}
      {%- endfor -%}
      <div
              data-variant-id="{{ variant.id }}"
              data-options='{{ variant.options | json | escape }}'
              data-protein="{{ n.protein }}"
              data-serving-size="{{ n.ssize }}"
              data-servings-fallback="{{ n.servingsPerContainer }}"
              data-container-grams="{{ container_grams }}"
              data-price="{{ variant.price }}"
              data-price-formatted="{{ variant.price | money | strip_html }}"
              data-subscription-price="{{ _sub_price }}"
              data-subscription-price-formatted="{{ _sub_price | money | strip_html }}">
      </div>
    {% endif %}
  {% endfor %}
</div>

<script>
  (function() {
    const root = document.getElementById('nutrition-data');
    if (!root) return;

    function numberFrom(value) {
      const number = parseFloat(String(value || '').replace(/[^0-9.]/g, ''));
      return Number.isFinite(number) ? number : 0;
    }

    function getVariantData(variantId) {
      if (!variantId) return null;
      return root.querySelector('[data-variant-id="' + variantId + '"]');
    }

    function getOptions(data) {
      if (!data) return [];
      try { return JSON.parse(data.dataset.options || '[]'); }
      catch (error) { return []; }
    }

    function servingsFor(data) {
      if (!data) return 0;
      const containerGrams = numberFrom(data.dataset.containerGrams);
      const servingSize = numberFrom(data.dataset.servingSize);
      const fallbackServings = numberFrom(data.dataset.servingsFallback);

      if (containerGrams > 0 && servingSize > 0) return Math.round(containerGrams / servingSize);
      {%- if template.suffix == 'creatine-monohydrate' -%}
      if (containerGrams > 0) return Math.round(containerGrams / 5);
      {%- endif -%}
      if (fallbackServings > 0) return Math.round(fallbackServings);
      return 0;
    }

    function isSubscriptionActive() {
      var sp = document.querySelector('input[name="selling_plan"]');
      return sp && sp.value && sp.value !== '0' && sp.value !== '';
    }

    function activePriceCents(data) {
      if (isSubscriptionActive()) {
        var subPrice = numberFrom(data.dataset.subscriptionPrice);
        if (subPrice > 0) return subPrice;
      }
      return numberFrom(data.dataset.price);
    }

    function costFor(data) {
      const servings = servingsFor(data);
      const priceCents = activePriceCents(data);
      if (!servings || !priceCents) return '—';
      return '$' + (priceCents / 100 / servings).toFixed(2);
    }

    function findVariantByOptions(options) {
      return Array.from(root.querySelectorAll('[data-variant-id]')).find(function(data) {
        const variantOptions = getOptions(data);
        return options.length === variantOptions.length && options.every(function(option, index) {
          return String(option) === String(variantOptions[index]);
        });
      });
    }

    function getMainForm() {
      return document.getElementById(root.dataset.productForm) || document.querySelector('form[action$="/cart/add"]');
    }

    function getCurrentVariantId() {
      const form = getMainForm();
      const formVariant = form && form.querySelector('[name="id"]');
      if (formVariant && formVariant.value) return formVariant.value;

      const selectedOption = document.querySelector('select[name="id"] option:checked');
      if (selectedOption) return selectedOption.value;

      return null;
    }

    function updateSizeOptionCosts(currentData) {
      const picker = document.querySelector('hdt-variant-picker[form="' + root.dataset.productForm + '"]') || document.querySelector('hdt-variant-picker');
      if (!picker || !currentData) return;

      const currentOptions = getOptions(currentData);
      if (!currentOptions.length) return;

      picker.querySelectorAll('fieldset[data-index]').forEach(function(fieldset) {
        const legend = fieldset.querySelector('legend');
        const isSizeField = legend && /size/i.test(legend.textContent || '');
        if (!isSizeField) return;

        const optionIndex = parseInt(fieldset.dataset.index, 10);
        fieldset.querySelectorAll('input[type="radio"]').forEach(function(input) {
          const label = input.nextElementSibling;
          const costLabel = label && label.querySelector('.size-label-cost');
          const nameLabel = label && label.querySelector('.size-label-name');
          if (!costLabel) return;

          const options = currentOptions.slice();
          options[optionIndex] = input.value;
          const variantData = findVariantByOptions(options);
          costLabel.textContent = variantData ? costFor(variantData) + '/serving' : '—/serving';

          if (nameLabel) {
            const baseName = input.value.split('(')[0].trim();
            if (variantData) {
              const servings = servingsFor(variantData);
              nameLabel.textContent = servings > 0 ? baseName + ' \u00b7 ' + servings + ' servings' : baseName;
            } else {
              nameLabel.textContent = baseName;
            }
          }
        });
      });
    }

    function updateBoxes(variantId) {
      const data = getVariantData(variantId);
      if (!data) return;

      const boxRoot = document.getElementById('nutrition-boxes');
      if (!boxRoot) return;

      const protein = boxRoot.querySelector('[data-protein]');
      const servings = boxRoot.querySelector('[data-servings]');
      const cost = boxRoot.querySelector('[data-cost]');
      const calculatedServings = servingsFor(data);

      if (protein) protein.textContent = data.dataset.protein ? data.dataset.protein + 'g' : '—';
      if (servings) servings.textContent = calculatedServings || '—';
      if (cost) cost.textContent = costFor(data);

      // Update price-per-serving display (both desktop and mobile)
      const priceServingsCost = costFor(data);
      document.querySelectorAll('.cp-price-servings-count').forEach(function(el) {
        el.textContent = calculatedServings > 0 ? calculatedServings + ' servings' : '—';
      });
      document.querySelectorAll('.cp-price-servings-cost').forEach(function(el) {
        el.textContent = priceServingsCost !== '—' ? priceServingsCost + '/serving' : '—/serving';
      });

      updateSizeOptionCosts(data);
    }

    function updateFromCurrentVariant() {
      const id = getCurrentVariantId();
      if (id) updateBoxes(id);
    }

    function observeVariantField() {
      const form = getMainForm();
      const variantField = form && form.querySelector('[name="id"]');
      if (variantField) {
        new MutationObserver(updateFromCurrentVariant).observe(variantField, {
          attributes: true,
          attributeFilter: ['value']
        });
      }
    }

    function watchSellingPlan() {
      var sp = document.querySelector('input[name="selling_plan"]');
      if (sp) {
        new MutationObserver(updateFromCurrentVariant).observe(sp, {
          attributes: true, attributeFilter: ['value']
        });
        sp.addEventListener('change', updateFromCurrentVariant);
        return;
      }
      var attempts = 0;
      var interval = setInterval(function() {
        attempts++;
        var sp = document.querySelector('input[name="selling_plan"]');
        if (sp) {
          clearInterval(interval);
          new MutationObserver(updateFromCurrentVariant).observe(sp, {
            attributes: true, attributeFilter: ['value']
          });
          sp.addEventListener('change', updateFromCurrentVariant);
        } else if (attempts >= 50) {
          clearInterval(interval); // stop after 15 s
        }
      }, 300);
    }

    document.addEventListener('DOMContentLoaded', function() {
      updateFromCurrentVariant();
      observeVariantField();
      watchSellingPlan();
    });

    document.addEventListener('variant:change', function(event) {
      const variant = event.detail && event.detail.variant;
      if (variant && variant.id) {
        updateBoxes(String(variant.id));
        var boxes = document.getElementById('nutrition-boxes');
        // Only show boxes if this is a real flavor change (different variant)
        // seekSlider can fire variant:change spuriously with the same variant ID
        var variantChanged = window._cpThumbFlagVariantId !== String(variant.id);
        if (!window._cpCustomThumbActive || variantChanged) {
          window._cpCustomThumbActive = false;
          window._cpThumbFlagVariantId = null;
          if (boxes) boxes.classList.remove('cp-boxes-hidden');
        }
      }
    });

    document.addEventListener('change', function(event) {
      if (event.target.name === 'id' || event.target.closest('hdt-variant-picker')) {
        setTimeout(updateFromCurrentVariant, 0);
      }
    });

    document.addEventListener('rc:optionchange', updateFromCurrentVariant);
  })();
</script>

<style>
  .nemo-media-wrapper {
    display: block;
  }
  {%- if template.suffix == 'default-protein' or template.suffix == 'dfltprdct-exclusion' or template.suffix == 'creatine-monohydrate' -%}
  .hdt-product-media__main {
    position: relative;
  }
  .nutrition-boxes {
    position: absolute;
    bottom: 16px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .nutrition-boxes.cp-boxes-hidden {
