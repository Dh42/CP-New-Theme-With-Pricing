            </div>
            <div class="cp-custom-thumb" data-slide-index="{{ cp_slide1 }}" data-custom-index="1">
              {{ cp_img_back | image_url: width: 160 | image_tag: alt: 'Back', loading: 'lazy' }}
            </div>
            <div class="cp-custom-thumb" data-slide-index="{{ cp_slide2 }}" data-custom-index="2">
              {{ cp_img_scoop | image_url: width: 160 | image_tag: alt: 'Scoop', loading: 'lazy' }}
            </div>
            <div class="cp-custom-thumb" data-slide-index="{{ cp_slide3 }}" data-custom-index="3">
              {{ cp_img_lifestyle | image_url: width: 160 | image_tag: alt: 'Lifestyle', loading: 'lazy' }}
            </div>
          </div>
        {%- endcapture -%}
      {%- endif -%}
      {%- liquid
        assign cp_is_bestseller = false
        assign cp_sold_count = ''
        assign cp_bs_map = "bestseller-1:10000,bestseller-2:9000,bestseller-3:8000,bestseller-4:7000,bestseller-5:6000,bestseller-6:5000,bestseller-7:4000,bestseller-8:3000,bestseller-9:2000,bestseller-10:1000" | split: ","
        for bs_entry in cp_bs_map
          assign bs_parts = bs_entry | strip | split: ":"
          assign bs_tag = bs_parts[0]
          assign bs_num = bs_tag | remove: 'bestseller-' | plus: 0
          if product.tags contains bs_tag
            assign cp_sold_count = bs_parts[1]
            if bs_num <= 4
              assign cp_is_bestseller = true
            endif
            break
          endif
        endfor
      -%}
