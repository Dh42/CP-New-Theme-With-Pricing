    font-size: 11px;
    color: #777;
    text-transform: capitalize;
    letter-spacing: 0.03em;
    text-align: left;
    line-height: 1.35;
  }
  .nutrition-box--protein {
    background: rgb(0, 186, 219);
    padding: 16px 14px;
  }
  .nutrition-box--protein .value {
    color: #fff;
    font-size: 32px;
  }
  .nutrition-box--protein .label {
    color: rgba(255, 255, 255, 0.88);
  }
  .nutrition-box-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: auto;
  }
  .cp-image-top-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    z-index: 3;
    pointer-events: none;
  }
  .cp-image-top-badges__left {
    display: flex;
    flex-direction: column;
    gap: 5px;
    pointer-events: auto;
  }
  .cp-bestseller-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    background: #1A1A18;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    font-family: 'Albert Sans', sans-serif;
    gap: 4px;
  }
  .cp-sold-count {
    font-size: 13px;
    color: #1A1A18;
    font-family: 'Albert Sans', sans-serif;
    font-weight: 600;
    padding-left: 2px;
  }
  .cp-sold-count strong {
    font-weight: 800;
  }
  .cp-lab-tested-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #fff;
    border: 1.5px solid #22c55e;
    color: #16a34a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    pointer-events: auto;
    font-family: 'Albert Sans', sans-serif;
  }
  .cp-custom-thumbs-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding: 10px 0 4px;
    /* Force it onto its own line inside the flex container */
    width: 100%;
    order: 99;
    flex-shrink: 0;
  }
  /* Allow hdt-product-media to wrap so our row goes below main+thumb */
  hdt-product-media:has(.cp-custom-thumbs-row) {
