    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
  }
  {%- endif -%}
</style>

{%- if template.suffix == 'default-protein' or template.suffix == 'dfltprdct-exclusion' or template.suffix == 'creatine-monohydrate' -%}
<script>
(function() {
  var SLIDER_ID = 'slider-{{ section.id }}-{{ product.id }}';

  function seekSlider(index) {
    var el = document.getElementById(SLIDER_ID);
    if (!el) return;
    // hdt-slider exposes scrollToIndex(index) as its public navigation method
    if (typeof el.scrollToIndex === 'function') {
      el.scrollToIndex(index);
    }
  }

  // Finds the current Embla index of a custom slide by its ordinal position (0-3)
  // among .cp-custom-media-slide elements. Needed because Embla re-inits on variant
  // change and the absolute slide index stored in data-slide-index becomes stale.
  function seekToCustomSlide(customIndex) {
    var el = document.getElementById(SLIDER_ID);
    if (!el) return;
    var allSlides = Array.from(el.querySelectorAll('.hdt-slider__slide:not([hidden])'));
    var customSlides = allSlides.filter(function(s) { return s.classList.contains('cp-custom-media-slide'); });
    if (customIndex >= customSlides.length) return;
    var emblaIdx = allSlides.indexOf(customSlides[customIndex]);
    if (emblaIdx >= 0 && typeof el.scrollToIndex === 'function') {
      el.scrollToIndex(emblaIdx);
    }
  }

  function initCustomThumbs() {
    var container = document.getElementById('cp-custom-thumbs');
    if (!container) return;
    var thumbs = container.querySelectorAll('.cp-custom-thumb');

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        var customIndex = parseInt(this.dataset.customIndex, 10);
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        // Hide boxes first — before seek so it runs even if seek throws
        var boxes = document.getElementById('nutrition-boxes');
        if (boxes) boxes.classList.add('cp-boxes-hidden');
        // Store current variant ID so variant:change can tell if flavor actually changed
        var variantInput = document.querySelector('[name="id"]');
        window._cpThumbFlagVariantId = variantInput ? String(variantInput.value) : null;
        window._cpCustomThumbActive = true;
        seekToCustomSlide(customIndex);
      });
    });

    // Remove active state from custom thumbs when slider moves to a product slide
    var sliderEl = document.getElementById(SLIDER_ID);
    if (sliderEl) {
      sliderEl.addEventListener('scroll', function() {
        // Timeout lets the slider settle before checking index
        clearTimeout(sliderEl._cpScrollTimer);
        sliderEl._cpScrollTimer = setTimeout(function() {
          var embla = sliderEl._embla || sliderEl.embla || sliderEl.slider;
          if (!embla || typeof embla.selectedScrollSnap !== 'function') return;
          var currentIndex = embla.selectedScrollSnap();
          var customStart = {{ product.media.size }};
          if (currentIndex < customStart) {
            thumbs.forEach(function(t) { t.classList.remove('active'); });
            window._cpCustomThumbActive = false;
            window._cpThumbFlagVariantId = null;
            var boxes = document.getElementById('nutrition-boxes');
            if (boxes) boxes.classList.remove('cp-boxes-hidden');
          }
        }, 100);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomThumbs);
  } else {
    initCustomThumbs();
  }
})();
</script>
{%- endif -%}

{% comment %} endnemo {% endcomment %}

<div class="nemo-media-wrapper">
  <div class="nemo-slider-col">
    {%- if template.suffix == 'default-protein' or template.suffix == 'dfltprdct-exclusion' or template.suffix == 'creatine-monohydrate' -%}
      {%- if cp_has_all_images -%}
        {%- assign cp_slide0 = product.media.size -%}
        {%- assign cp_slide1 = product.media.size | plus: 1 -%}
        {%- assign cp_slide2 = product.media.size | plus: 2 -%}
        {%- assign cp_slide3 = product.media.size | plus: 3 -%}
        {%- capture cp_custom_slides_html -%}
          <div class="hdt-slider__slide cp-custom-media-slide">
            <div class="hdt-product__media" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;">
              {{ cp_img_front | image_url: width: 1200 | image_tag: alt: 'Front', loading: 'lazy', style: 'max-width:100%;max-height:100%;object-fit:contain;' }}
            </div>
          </div>
          <div class="hdt-slider__slide cp-custom-media-slide">
            <div class="hdt-product__media" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;">
              {{ cp_img_back | image_url: width: 1200 | image_tag: alt: 'Back', loading: 'lazy', style: 'max-width:100%;max-height:100%;object-fit:contain;' }}
            </div>
          </div>
          <div class="hdt-slider__slide cp-custom-media-slide">
            <div class="hdt-product__media" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;">
              {{ cp_img_scoop | image_url: width: 1200 | image_tag: alt: 'Scoop', loading: 'lazy', style: 'max-width:100%;max-height:100%;object-fit:contain;' }}
            </div>
          </div>
          <div class="hdt-slider__slide cp-custom-media-slide">
            <div class="hdt-product__media" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;">
              {{ cp_img_lifestyle | image_url: width: 1200 | image_tag: alt: 'Lifestyle', loading: 'lazy', style: 'max-width:100%;max-height:100%;object-fit:contain;' }}
            </div>
          </div>
        {%- endcapture -%}
        {%- capture cp_custom_block_html -%}
          <div class="cp-custom-thumbs-row" id="cp-custom-thumbs">
            <div class="cp-custom-thumb" data-slide-index="{{ cp_slide0 }}" data-custom-index="0">
