    "accordion_JYiMAQ": {
      "type": "accordion",
      "blocks": {
        "title_KtAttM": {
          "type": "title",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "accordion_item_T9cB3Q": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the Canadian Protein Cyber Monday Sale?",
            "content": "The Sale is a limited-time event on CanadianProtein.com offering major discounts, free gifts, and special giveaways.\n All promotional offers are valid only during the Sale period and while supplies last."
          }
        },
        "accordion_item_g8w4wQ": {
          "type": "accordion_item",
          "settings": {
            "title": "What does “Up to 70% Off” mean?",
            "content": "“Up to 70% Off” refers to the highest possible discount available on select products during the Sale. Not all products will reach 70% off."
          }
        },
        "accordion_item_aTG3Aq": {
          "type": "accordion_item",
          "settings": {
            "title": "Can I combine discount codes with Sale prices?",
            "content": "No. Sale discounts cannot be combined with promo codes, referral codes, loyalty rewards, point redemptions, or third-party offers unless Canadian Protein explicitly states otherwise."
          }
        },
        "accordion_item_nW3Nnd": {
          "type": "accordion_item",
          "settings": {
            "title": "Are subscriptions included in the Cyber Monday Sale?",
            "content": "Yes.\n Eligible subscription products receive 35% off during the Sale.\n Some products may be excluded at Canadian Protein’s discretion.\n Subscription discounts cannot be stacked with other offers."
          }
        },
        "accordion_item_yjjb7Y": {
          "type": "accordion_item",
          "settings": {
            "title": "What free gifts can I receive during the Sale?",
            "content": "While supplies last:\n<br>\nA Mystery Product is included with every order over $1.\n<br>\n\nA Canadian Protein Mystery Supplement is included with orders of $150+ (before taxes and after discounts).\n<br> Free gifts cannot be substituted, exchanged, or refunded."
          }
        },
        "accordion_item_kpRB9U": {
          "type": "accordion_item",
          "settings": {
            "title": "Are there any exclusions in this sale?",
            "content": "Yes. exclusions include but are not limited to :\n<br>\n\n - Protein Coffee Original Blend\n<br>\nCanadian Protein reserves the right to modify this list any time without notice."
          }
        },
        "accordion_item_74cqU4": {
          "type": "accordion_item",
          "settings": {
            "title": "How does the “Win Your Order Refunded” promotion work?",
