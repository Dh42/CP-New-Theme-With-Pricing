        "text_WcPBFm": {
          "type": "text",
          "settings": {
            "text": "<p>From proteins to supplements, find your favourites <strong>at huge discounts, only for a limited time.</strong><br/>No code needed, discounts applied at checkout.</p>",
            "text_size": "base",
            "alignment": "start",
            "alignment_mb": "start"
