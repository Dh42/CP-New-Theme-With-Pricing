      "blocks": {
        "title_QMaciC": {
          "type": "title",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "accordion_item_yT6fX4": {
          "type": "accordion_item",
          "settings": {
            "title": "How does Buy More Save More work?",
            "content": "It's simple — the more eligible products you add to your cart, the bigger your discount. Buy 2 and save 15%, buy 3 and save 20%, or buy 5 or more and save 25%. Mix and match within either category: proteins or supplements. The more you add, the more you save — automatically at checkout, no code needed."
          }
        },
        "accordion_item_4yKUMN": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a promo code to get the discount?",
            "content": "No code required. The discount is applied automatically at checkout as soon as you reach a qualifying tier."
          }
        },
        "accordion_item_JRcMaU": {
          "type": "accordion_item",
          "settings": {
            "title": "Which products are eligible?",
            "content": "Most Canadian Protein products qualify. A small number of items — like bulk protein, gift cards, and sale items — are excluded. Look for the \"Buy More Save More\" badge on eligible product pages."
          }
        },
        "accordion_item_ijzxVc": {
          "type": "accordion_item",
          "settings": {
            "title": "Can I mix and match different products?",
            "content": "Yes — that's the best part. Your tier is based on the total number of eligible products in your cart, not how many of the same item you buy. It is however based on category, you must add 2+ to you cart of either protein products or supplement products."
          }
        },
        "accordion_item_nJVyaJ": {
          "type": "accordion_item",
          "settings": {
            "title": "Can I combine different flavours or sizes of the same product?",
            "content": "Absolutely. Two bags of Whey Isolate in different flavours count as two products. Same goes for different sizes."
          }
        },
        "accordion_item_qxRJ9y": {
          "type": "accordion_item",
          "settings": {
            "title": "Does Buy More Save More stack with other discounts or promo codes?",
            "content": "Buy More Save More cannot be combined with other promotional codes or site-wide sales.Subscribe & Save customers cannot stack their subscription discount on top."
          }
        },
        "accordion_item_MG9jTt": {
          "type": "accordion_item",
          "settings": {
            "title": "Is there a limit to how much I can save?",
            "content": "The maximum tier is 25% off when you buy 5 or more eligible products."
          }
        },
        "accordion_item_K6fnFM": {
          "type": "accordion_item",
          "settings": {
            "title": "When does the program end?",
            "content": "Buy More Save More is an ongoing program (other than during select sales)— no end date, no countdown. Stock up whenever it works for you."
          }
        }
