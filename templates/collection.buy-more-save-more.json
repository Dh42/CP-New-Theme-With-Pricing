        "custom_liquid_UJ3VVM": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .savings-tiers {\n    font-family: 'Albert Sans', sans-serif;\n    display: flex;\n    flex-direction: row;\n    gap: 20px;\n    padding: 20px;\n    background: transparent;\n    max-width: 1200px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .savings-tiers__card {\n    flex: 1 1 0;\n    border: 1px solid rgba(255, 255, 255, 1);\n    border-radius: 16px;\n    padding: 30px 10px;\n    text-align: center;\n    background: rgba(0, 0, 0, 0.75);\n    min-width: 0;\n  }\n\n  .savings-tiers__title {\n    font-size: 28px;\n    font-weight: 500;\n    color: #ffffff;\n    margin: 0 0 12px 0;\n    line-height: 1.2;\n  }\n\n  .savings-tiers__subtitle {\n    font-size: 16px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0;\n    line-height: 1.4;\n  }\n\n  @media (max-width: 749px) {\n    .savings-tiers {\n      gap: 8px;\n      padding: 10px;\n    }\n    .savings-tiers__card {\n      padding: 20px 6px;\n      border-radius: 10px;\n    }\n    .savings-tiers__title {\n      font-size: 16px;\n      margin-bottom: 6px;\n    }\n    .savings-tiers__subtitle {\n      font-size: 11px;\n      line-height: 1.3;\n    }\n  }\n</style>\n\n<div class=\"savings-tiers\">\n  <div class=\"savings-tiers__card\">\n    <h3 class=\"savings-tiers__title\">Save 15%</h3>\n    <p class=\"savings-tiers__subtitle\">When you buy 2 items</p>\n  </div>\n  <div class=\"savings-tiers__card\">\n    <h3 class=\"savings-tiers__title\">Save 20%</h3>\n    <p class=\"savings-tiers__subtitle\">When you buy 3 or 4 items</p>\n  </div>\n  <div class=\"savings-tiers__card\">\n    <h3 class=\"savings-tiers__title\">Save 25%</h3>\n    <p class=\"savings-tiers__subtitle\">When you buy 5 or more items</p>\n  </div>\n</div>"
          }
