      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<style>\n  .cp-sale-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 8px;\n  }\n  .cp-sale-card {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    text-decoration: none;\n    background-color: #1a1a1a;\n    padding: 18px 22px;\n    border-radius: 4px;\n    overflow: hidden;\n    transition: background-color .2s ease;\n  }\n  .cp-sale-card:hover {\n    background-color: #c8102e;\n  }\n  .cp-sale-img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.18;\n    transition: opacity .2s ease;\n  }\n  .cp-sale-card:hover .cp-sale-img {\n    opacity: 0.25;\n  }\n  .cp-sale-text {\n    position: relative;\n    z-index: 1;\n    font-size: clamp(13px, 1.2vw, 16px);\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: #ffffff;\n  }\n  .cp-sale-arrow {\n    position: relative;\n    z-index: 1;\n    color: #ffffff;\n    font-size: 20px;\n    line-height: 1;\n    transition: transform .2s ease;\n  }\n  .cp-sale-card:hover .cp-sale-arrow {\n    transform: translateX(4px);\n  }\n  @media (max-width: 640px) {\n    .cp-sale-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"cp-sale-grid\">\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-30-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/30_off.png?v=1781715425\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 30% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-50-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/50_off.png?v=1781719822\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 50% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-60-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/60_off.png?v=1781720329\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 60% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-70-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/70_off_2.png?v=1781721326\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 70% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n</div>",
