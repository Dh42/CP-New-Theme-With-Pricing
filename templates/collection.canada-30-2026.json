          "type": "accordion_item",
          "settings": {
            "title": "What discounts are included in the Canada Day Sale?",
            "content": "30% off proteins and supplements, applied automatically at checkout\n<br>Up to 50% off select marked-down items\n<br>Up to 60% off select limited-quantity items \n<br>Up to 70% off apparel and gym equipment\n<br>3× rewards points on all orders\n<br>A free gift with every order of $1 or more"
          }
