        },
        "accordion_item_yXDAPE": {
          "type": "accordion_item",
          "settings": {
            "title": "What are the 3× rewards points?",
            "content": "During the Sale, you'll earn triple the usual rewards points on every order. Points are added to your account automatically and can be used toward future purchases through the Canadian Protein rewards program."
          }
        },
        "accordion_item_NAxYRT": {
          "type": "accordion_item",
          "settings": {
            "title": "I signed up for Early Access — where are my rewards points?",
            "content": "Points may take a short time to appear in your account. If they haven't shown up after 24 hours, please contact Canadian Protein customer support."
          }
        },
