            "title": "What is the free gift?",
            "content": "Every order of $1 or more includes a free gift while supplies last. Possible gifts include Glutamine, Leucine, or BCAAs+ in Berry Fusion or Citrus Twist flavours. Your gift is chosen at random and is subject to availability."
          }
        },
        "accordion_item_anYHhY": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a discount code?",
            "content": "No. All Sale discounts are applied automatically at checkout. You do not need to enter a code."
          }
        },
        "accordion_item_QcmfXb": {
          "type": "accordion_item",
          "settings": {
            "title": "Are there any products excluded from the Sale?",
            "content": "Yes. Bulk protein in 6kg and 10kg sizes does not qualify for Sale pricing and is excluded from all discounts. Some other exclusions may apply and will be noted on the product page."
