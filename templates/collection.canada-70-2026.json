        },
        "accordion_item_aqRHxt": {
          "type": "accordion_item",
          "settings": {
            "title": "What discounts are included in the Canada Day Sale?",
            "content": "30% off proteins and supplements, applied automatically at checkout\n<br>Up to 50% off select marked-down items\n<br>Up to 60% off select limited-quantity items \n<br>Up to 70% off apparel and gym equipment\n<br>3× rewards points on all orders\n<br>A free gift with every order of $1 or more"
          }
        },
        "accordion_item_HYtk9r": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the free gift?",
            "content": "Every order of $1 or more includes a free gift while supplies last. Possible gifts include Glutamine, Leucine, or BCAAs+ in Berry Fusion or Citrus Twist flavours. Your gift is chosen at random and is subject to availability."
          }
        },
        "accordion_item_anYHhY": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a discount code?",
            "content": "No. All Sale discounts are applied automatically at checkout. You do not need to enter a code."
          }
        },
        "accordion_item_QcmfXb": {
          "type": "accordion_item",
          "settings": {
            "title": "Are there any products excluded from the Sale?",
            "content": "Yes. Bulk protein in 6kg and 10kg sizes does not qualify for Sale pricing and is excluded from all discounts. Some other exclusions may apply and will be noted on the product page."
          }
        },
        "accordion_item_yXDAPE": {
          "type": "accordion_item",
          "settings": {
            "title": "What are the 3× rewards points?",
            "content": "During the Sale, you'll earn triple the usual rewards points on every order. Points are added to your account automatically and can be used toward future purchases through the Canadian Protein rewards program."
          }
        },
        "accordion_item_NAxYRT": {
          "type": "accordion_item",
          "settings": {
            "title": "I signed up for Early Access — where are my rewards points?",
            "content": "Points may take a short time to appear in your account. If they haven't shown up after 24 hours, please contact Canadian Protein customer support."
          }
        },
        "accordion_item_Md6JYm": {
          "type": "accordion_item",
          "settings": {
            "title": "My discount isn't showing at checkout — what should I do?",
            "content": "Make sure you're shopping for eligible products (bulk products are excluded). If the discount still isn't appearing, try refreshing your cart or contact Canadian Protein customer support for help."
          }
        },
        "accordion_item_chAmcj": {
          "type": "accordion_item",
          "settings": {
            "title": "Can I return or exchange a Sale item?",
            "content": "Please refer to the Canadian Protein returns policy for full details on returns and exchanges during the Sale period."
          }
        }
