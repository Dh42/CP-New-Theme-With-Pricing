    "custom_liquid_iKCKQG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<style>\n  .cp-sale-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 8px;\n  }\n  .cp-sale-card {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    text-decoration: none;\n    background-color: #1a1a1a;\n    padding: 18px 22px;\n    border-radius: 4px;\n    overflow: hidden;\n    transition: background-color .2s ease;\n  }\n  .cp-sale-card:hover {\n    background-color: #c8102e;\n  }\n  .cp-sale-img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.18;\n    transition: opacity .2s ease;\n  }\n  .cp-sale-card:hover .cp-sale-img {\n    opacity: 0.25;\n  }\n  .cp-sale-text {\n    position: relative;\n    z-index: 1;\n    font-size: clamp(13px, 1.2vw, 16px);\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: #ffffff;\n  }\n  .cp-sale-arrow {\n    position: relative;\n    z-index: 1;\n    color: #ffffff;\n    font-size: 20px;\n    line-height: 1;\n    transition: transform .2s ease;\n  }\n  .cp-sale-card:hover .cp-sale-arrow {\n    transform: translateX(4px);\n  }\n  @media (max-width: 640px) {\n    .cp-sale-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"cp-sale-grid\">\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-30-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/30_off.png?v=1781715425\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 30% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-50-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/50_off.png?v=1781719822\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 50% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-60-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/60_off.png?v=1781720329\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 60% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n  <a class=\"cp-sale-card\" href=\"https://canadianprotein.com/collections/canada-day-sale-2026-70-off\">\n    <img class=\"cp-sale-img\" src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/70_off_2.png?v=1781721326\" alt=\"\" loading=\"lazy\">\n    <span class=\"cp-sale-text\">Shop 70% Off</span>\n    <span class=\"cp-sale-arrow\">→</span>\n  </a>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
    "custom_liquid_zJtwxG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div id=\"cd-sale-slideout-trigger\"></div>\n\n<div id=\"cd-sale-slideout\" class=\"cd-sale-slideout\">\n  <button class=\"cd-sale-tab\" type=\"button\" aria-label=\"Open Canada Day Sale\">\n    🇨🇦\n  </button>\n\n  <div class=\"cd-sale-panel\">\n    <button class=\"cd-sale-close\" type=\"button\" aria-label=\"Minimize Canada Day Sale\">\n      ×\n    </button>\n\n    <div class=\"cd-sale-logo-wrap\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0249/3241/7583/files/Canada_Day_Sale_-_Logo_26.png?v=1782324874\" \n        alt=\"Canada Day Sale\" \n        class=\"cd-sale-logo\"\n      >\n    </div>\n\n    <div class=\"cd-sale-links\">\n      <a href=\"https://canadianprotein.com/collections/canada-day-sale#shopall\" class=\"cd-sale-link\">\n        <span class=\"cd-sale-link-text\">Shop All</span>\n        <span class=\"cd-sale-link-arrow\">→</span>\n      </a>\n\n      <a href=\"https://canadianprotein.com/collections/canada-day-sale-2026-30-off\" class=\"cd-sale-link\">\n        <span class=\"cd-sale-link-text\">Shop 30% off</span>\n        <span class=\"cd-sale-link-arrow\">→</span>\n      </a>\n\n      <a href=\"https://canadianprotein.com/collections/canada-day-sale-2026-50-off\" class=\"cd-sale-link\">\n        <span class=\"cd-sale-link-text\">Shop 50% off</span>\n        <span class=\"cd-sale-link-arrow\">→</span>\n      </a>\n\n      <a href=\"https://canadianprotein.com/collections/canada-day-sale-2026-60-off\" class=\"cd-sale-link\">\n        <span class=\"cd-sale-link-text\">Shop 60% off</span>\n        <span class=\"cd-sale-link-arrow\">→</span>\n      </a>\n\n      <a href=\"https://canadianprotein.com/collections/canada-day-sale-2026-70-off\" class=\"cd-sale-link\">\n        <span class=\"cd-sale-link-text\">Shop 70% off</span>\n        <span class=\"cd-sale-link-arrow\">→</span>\n      </a>\n    </div>\n\n    <div class=\"cd-sale-perks\">\n      <span>Free Gift with $150+ Orders</span>\n      <span>2X Rewards</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .cd-sale-slideout {\n    position: fixed;\n    top: 50%;\n    right: 0;\n    z-index: 9999;\n    width: 270px;\n    max-width: calc(100vw - 50px);\n    transform: translateY(-50%) translateX(calc(100% + 60px));\n    opacity: 0;\n    pointer-events: none;\n    transition: transform 0.35s ease, opacity 0.25s ease;\n  }\n\n  .cd-sale-slideout.is-visible {\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .cd-sale-slideout.is-visible:not(.is-open) {\n    transform: translateY(-50%) translateX(100%);\n  }\n\n  .cd-sale-slideout.is-visible.is-open {\n    transform: translateY(-50%) translateX(0);\n  }\n\n  .cd-sale-tab {\n    position: absolute;\n    left: -46px;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 46px;\n    height: 54px;\n    border: 0;\n    background: #000000;\n    color: #ffffff;\n    font-size: 23px;\n    cursor: pointer;\n    box-shadow: 0 0 18px rgba(0, 0, 0, 0.28);\n    border-radius: 14px 0 0 14px;\n  }\n\n  .cd-sale-slideout.is-open .cd-sale-tab {\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .cd-sale-panel {\n    position: relative;\n    background: rgba(255, 255, 255, 0.14);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n    color: #111111;\n    padding: 20px 16px 18px;\n    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.10);\n    border: 1px solid rgba(255, 255, 255, 0.20);\n    border-radius: 16px 0 0 16px;\n    text-align: center;\n  }\n\n  .cd-sale-close {\n    position: absolute;\n    top: 5px;\n    right: 9px;\n    border: 0;\n    background: transparent;\n    color: #111111;\n    font-size: 25px;\n    line-height: 1;\n    cursor: pointer;\n  }\n\n  .cd-sale-logo-wrap {\n    width: 100%;\n    margin: 0 auto 14px;\n    text-align: center;\n  }\n\n  .cd-sale-logo {\n    max-width: 190px;\n    width: 100%;\n    height: auto;\n    display: block;\n    margin: 0 auto;\n  }\n\n  .cd-sale-links {\n    display: grid;\n    gap: 8px;\n    width: 100%;\n  }\n\n  .cd-sale-link {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    width: 100%;\n    min-height: 54px;\n    padding: 0 14px 0 16px;\n    background: rgba(0, 0, 0, 0.62);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    color: #ffffff;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 10px;\n    text-decoration: none;\n    box-sizing: border-box;\n    transition: all 0.22s ease;\n  }\n\n  .cd-sale-link:hover,\n  .cd-sale-link:active,\n  .cd-sale-link:focus {\n    background: rgba(0, 0, 0, 0.76);\n    color: #ffffff;\n    box-shadow: 0 0 18px rgba(0, 0, 0, 0.18);\n    transform: translateX(-3px);\n    outline: none;\n  }\n\n  .cd-sale-link-text {\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    text-align: left;\n  }\n\n  .cd-sale-link-arrow {\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    font-size: 21px;\n    font-weight: 700;\n    line-height: 1;\n    flex-shrink: 0;\n  }\n\n  .cd-sale-perks {\n    margin-top: 16px;\n    display: grid;\n    gap: 7px;\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    font-size: 10px;\n    font-weight: 800;\n    text-transform: uppercase;\n    line-height: 1.15;\n    letter-spacing: 0.03em;\n    color: #111111;\n  }\n\n  @media screen and (max-width: 600px) {\n    .cd-sale-slideout {\n      width: 258px;\n    }\n\n    .cd-sale-panel {\n      padding: 18px 14px 17px;\n    }\n\n    .cd-sale-logo {\n      max-width: 182px;\n    }\n\n    .cd-sale-link {\n      min-height: 52px;\n      padding: 0 13px 0 15px;\n    }\n\n    .cd-sale-link-text {\n      font-size: 13px;\n      letter-spacing: 0.12em;\n    }\n\n    .cd-sale-link-arrow {\n      font-size: 20px;\n    }\n\n    .cd-sale-perks {\n      font-size: 9px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const trigger = document.getElementById(\"cd-sale-slideout-trigger\");\n    const slideout = document.getElementById(\"cd-sale-slideout\");\n    const openBtn = slideout.querySelector(\".cd-sale-tab\");\n    const closeBtn = slideout.querySelector(\".cd-sale-close\");\n\n    let userMinimized = false;\n\n    function updateSlideout() {\n      const triggerPassed = trigger.getBoundingClientRect().bottom < 0;\n\n      if (triggerPassed) {\n        slideout.classList.add(\"is-visible\");\n\n        if (!userMinimized) {\n          slideout.classList.add(\"is-open\");\n        }\n      } else {\n        slideout.classList.remove(\"is-visible\", \"is-open\");\n      }\n    }\n\n    closeBtn.addEventListener(\"click\", function () {\n      userMinimized = true;\n      slideout.classList.remove(\"is-open\");\n    });\n\n    openBtn.addEventListener(\"click\", function () {\n      userMinimized = false;\n      slideout.classList.add(\"is-open\");\n    });\n\n    window.addEventListener(\"scroll\", updateSlideout, { passive: true });\n    window.addEventListener(\"resize\", updateSlideout);\n\n    updateSlideout();\n  });\n</script>",
