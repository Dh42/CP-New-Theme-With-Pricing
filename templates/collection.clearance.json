    "custom_liquid_wQQeaN": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<script>\n(function () {\n  function whenGtagReady(cb, attempts) {\n    attempts = attempts || 0;\n    if (typeof window.gtag === \"function\") return cb();\n    if (attempts > 60) {\n      console.warn(\"[StickyVideo][GA] gtag not found after ~6s\");\n      return;\n    }\n    setTimeout(function(){ whenGtagReady(cb, attempts + 1); }, 100);\n  }\n\n  function bindSoundTracking() {\n    console.log(\"[StickyVideo][GA] Sound tracking bound.\");\n\n    function sendEvent(name, params) {\n      console.log(\"[StickyVideo][GA] ✅ Sending:\", name, params);\n      try { window.gtag(\"event\", name, params || {}); } catch(e) {\n        console.error(\"[StickyVideo][GA] gtag error:\", e);\n      }\n    }\n\n    function handler(evt) {\n      var btn = evt.target.closest && evt.target.closest(\"#hdtStickySoundBtn\");\n      if (!btn) return;\n\n      var vid = document.getElementById(\"hdtStickyVideoEl\");\n      if (!vid) return;\n\n      // Capture state BEFORE your click handler toggles it\n      var beforeMuted = vid.muted;\n\n      console.log(\"[StickyVideo][GA] Click detected. beforeMuted =\", beforeMuted);\n\n      // Wait for your click handler to run, then read state AFTER\n      setTimeout(function () {\n        var afterMuted = vid.muted;\n        console.log(\"[StickyVideo][GA] After click. afterMuted =\", afterMuted);\n\n        // Fire ONLY if user turned sound ON (muted -> unmuted)\n        var turnedOn = (beforeMuted === true && afterMuted === false);\n\n        if (turnedOn) {\n          sendEvent(\"Sticky Sound On\", {\n            video_src: vid.currentSrc || vid.getAttribute(\"src\") || \"\",\n            page_path: location.pathname,\n            page_location: location.href\n          });\n        } else {\n          console.log(\"[StickyVideo][GA] ⛔ Not sending (not a muted→unmuted transition).\");\n        }\n      }, 0);\n    }\n\n    // Capture phase so we reliably detect the click even if propagation changes\n    document.addEventListener(\"click\", handler, true);\n  }\n\n  whenGtagReady(bindSoundTracking);\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
    "custom_liquid_VWXB7E": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
