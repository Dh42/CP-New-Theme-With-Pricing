      "blocks": {
        "title_8rd3Fa": {
          "type": "title",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "accordion_item_HbG88i": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the Groundhog Day Flash Sale?",
            "content": "The Groundhog Day Flash Sale offers 25% off sitewide on eligible items for a limited time."
          }
        },
        "accordion_item_3C3MkB": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a promo code to receive the discount?",
            "content": "Yes, the code GROUNDHOG25 will be required."
          }
        },
        "accordion_item_d7Bhnj": {
          "type": "accordion_item",
          "settings": {
            "title": "Are any products excluded from the sale?",
            "content": "Yes. The following items are excluded:<br>\n- Bulk Protein<br>\n - Gift Cards<br>\n - Any items excluded at the sole discretion of Canadian Protein<br>\nSome product types may sell out or be unavailable during the sale period."
          }
        },
        "accordion_item_9U63jh": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "Will the sale prices appear immediately?",
            "content": "Yes. Sale pricing will appear in your cart and at checkout.\n If you do not see a discount applied, the product may be excluded from the promotion."
          }
        },
        "accordion_item_GwXBpx": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How do I enter the Order Refund Promotion?",
            "content": "All you have to do is place an order during the Boxing Day Sale period, and you will be automatically entered!"
          }
        },
        "accordion_item_kjPEex": {
          "type": "accordion_item",
          "settings": {
            "title": "How long does the Flash Sale last?",
            "content": "This sale is available only for the limited promotional period on Groundhog Day.\n Once the flash sale ends, discounts cannot be applied to past or future orders."
          }
        },
        "accordion_item_tVmhc9": {
          "type": "accordion_item",
          "settings": {
            "title": "Will shipping times be affected?",
            "content": "At the moment, shipping times are unlikely to be affected. Should anything change, we’ll be sure to email you with an update."
          }
        },
        "accordion_item_7mgQP4": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the refund policy for sale items?",
            "content": "Refunds on sale items will be processed based on the discounted sale price, not the original full price. For more information about our refund policy, please\n  <a href=\"https://canadianprotein.com/pages/terms-and-conditions\" target=\"_blank\" rel=\"noopener noreferrer\">\n    <strong>click here</strong></a>"
          }
        },
        "accordion_item_WrRQNf": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How does the “Win Your Order Refunded” promotion work?",
            "content": "During the Sale window:\n<br>\nEvery customer who places an order is automatically entered for a chance to win a refund.\n<br>\n\n - Canadian Protein will select 2 winners by random draw.\n<br>\n\n - Refund covers product value only, not shipping, taxes, or fees.\n<br>\n\n - Must be 18+ and a resident of Canada (excluding Quebec).\n<br>\n\n - Maximum refund amount is $350 CAD.\n<br>\n\n - Winners must respond within 7 days to claim their prize."
          }
        },
        "accordion_item_jjPjXa": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How do I enter the Meta Glasses Giveaway?",
            "content": "Every order placed during the Sale counts as one automatic entry.\n One winner will receive Meta Glasses.\n The winner will be chosen by random draw and contacted by email."
          }
        },
        "accordion_item_h97bfe": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "Should I expect delays with shipping?",
            "content": "Yes.\n Due to high order volume during the Black Friday Cyber Monday Sale, shipping delays may occur."
          }
        }
      },
