        "accordion_item_g8w4wQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a discount code?",
            "content": "No. Discounts are automatically applied at checkout on all eligible items."
          }
        },
        "accordion_item_aTG3Aq": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "Can I combine discount codes with Sale prices?",
            "content": "No. Sale discounts cannot be combined with promo codes, referral codes, loyalty rewards, point redemptions, or third-party offers unless Canadian Protein explicitly states otherwise."
          }
        },
        "accordion_item_nW3Nnd": {
          "type": "accordion_item",
          "settings": {
            "title": "Are subscriptions included in the New Year, New You Sale?",
            "content": "Yes.\n Eligible subscription products receive 30% + and additional 5% off during the Sale.\n Some products may be excluded at Canadian Protein’s discretion.\n Subscription discounts cannot be stacked with other offers."
          }
        },
        "accordion_item_aP9Ffw": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How do I enter the Order Refund Promotion?",
