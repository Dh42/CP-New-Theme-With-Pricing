        "custom_liquid": "<div class=\"promo-button-grid yellow-pills\">\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=BFCM30#shopall\" class=\"promo-btn-pill\">30% OFF</a>\n\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=BFCM35#shopall\" class=\"promo-btn-pill\">up to 35% OFF</a>\n\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=bfcm40#shopall\" class=\"promo-btn-pill\">up to 40% OFF</a>\n\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=BFCM50#shopall\" class=\"promo-btn-pill\">up to 50% OFF</a>\n\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=BFCM60#shopall\" class=\"promo-btn-pill\">up to 60% OFF</a>\n\n  <a href=\"https://canadianprotein.com/collections/bfcm-2025?filter.574572=BFCM70#shopall\" class=\"promo-btn-pill\">up to 70% OFF</a>\n</div>\n\n<style>\n  .yellow-pills {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 12px;\n    margin: 22px 0;\n  }\n\n  .promo-btn-pill {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #000;               /* BLACK pill */\n    color: #F6FF00;                 /* BRIGHT yellow text */\n    padding: 10px 0;\n    font-size: 15px;\n    font-weight: 700;\n    border-radius: 9999px;\n    text-align: center;\n    text-decoration: none;\n    letter-spacing: 0.2px;\n    transition: 0.2s ease;\n    line-height: 1;\n  }\n\n  .promo-btn-pill:hover {\n    background: #F6FF00;           /* Yellow on hover */\n    color: #000;                   /* Black text on hover */\n  }\n\n  @media (max-width: 992px) {\n    .yellow-pills {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 480px) {\n    .promo-btn-pill {\n      font-size: 14px;\n      padding: 9px 0;\n    }\n  }\n</style>",
