IBLE drag handle (no black bar) */\n  .hdt-sticky-vidR__bar{\n    position:absolute;\n    top:0; left:0; right:0;\n    height:42px;\n    cursor:grab;\n    background:transparent;\n    z-index:5;\n  }\n  .hdt-sticky-vidR__bar:active{ cursor:grabbing; }\n\n  .hdt-sticky-vidR__body{\n    position:relative;\n    aspect-ratio:9/16;\n    width:100%;\n    background:#000;\n  }\n  .hdt-sticky-vidR__body video{\n    width:100%;\n    height:100%;\n    object-fit:cover;\n    display:block;\n  }\n\n  /* Outside close */\n  .hdt-sticky-vidR__close{\n    position:absolute;\n    top:-14px;\n    right:-14px;\n    width:34px;\n    height:34px;\n    border-radius:50%;\n    border:1px solid rgba(255,255,255,.25);\n    background:rgba(0,0,0,.85);\n    color:#fff;\n    font-size:22px;\n    line-height:1;\n    cursor:pointer;\n    box-shadow:0 6px 16px rgba(0,0,0,.35);\n  }\n\n  /* Positioning tab — TOP-LEFT, slightly outside */\n  .hdt-sticky-vidR__grab{\n    position:absolute;\n    left:-10px;\n    top:-10px;\n    width:44px;\n    height:30px;\n    background:#ea002a;\n    border-radius:999px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    box-shadow:0 8px 18px rgba(0,0,0,.25);\n    cursor:grab;\n  }\n  .hdt-sticky-vidR__grab:active{ cursor:grabbing; }\n\n  .hdt-grab-dots{\n    width:18px;\n    height:14px;\n    display:block;\n    background: radial-gradient(circle, #fff 2px, transparent 3px) 0 0/9px 7px;\n  }\n\n  /* Sound pill (mobile centered) */\n  .hdt-sticky-vidR__sound{\n    position:absolute;\n    left:10px;\n    right:10px;\n    bottom:10px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:8px;\n    padding:10px 12px;\n    border:0;\n    border-radius:999px;\n    background:rgba(234,0,42,.92);\n    color:#fff;\n    font-weight:800;\n    cursor:pointer;\n    box-shadow:0 8px 18px rgba(0,0,0,.25);\n  }\n\n  @media(max-width:989px){\n    .hdt-sticky-vidR__sound{\n      left:50%;\n      right:auto;\n      transform:translateX(-50%);\n      width:max-content;\n      max-width:calc(100% - 20px);\n      padding:9px 14px;\n      bottom:12px;\n      font-size:14px;\n    }\n    .hdt-snd-txt{ white-space:nowrap; }\n  }\n\n  /* Speaker icon (white) */\n  .hdt-snd-ic{\n    width:18px; height:18px; display:inline-block; position:relative;\n  }\n  .hdt-snd-ic:before{\n    content:\"\";\n    position:absolute;\n    left:0; top:4px;\n    width:8px; height:10px;\n    background:#fff;\n    clip-path: polygon(0 25%, 45% 25%, 100% 0, 100% 100%, 45% 75%, 0 75%);\n  }\n  .hdt-snd-ic:after{\n    content:\"\";\n    position:absolute;\n    left:9px; top:5px;\n    width:8px; height:8px;\n    border:2px solid #fff;\n    border-left-color:transparent;\n    border-bottom-color:transparent;\n    border-radius:50%;\n    transform:rotate(45deg);\n  }\n\n  /* When sound is ON, make pill darker */\n  .hdt-sticky-vidR.sound-on .hdt-sticky-vidR__sound{\n    background:rgba(0,0,0,.65);\n    border:1px solid rgba(255,255,255,.25);\n  }\n</style>\n\n<script>\n(()=> {\n  const wrap = document.getElementById('hdtStickyVidR');\n  const handle = document.getElementById('hdtStickyVidRHandle');\n  const grab = document.getElementById('hdtStickyGrab');\n  const closeBtn = document.getElementById('hdtStickyRClose');\n  const vid = document.getElementById('hdtStickyVideoEl');\n  const soundBtn = document.getElementById('hdtStickySoundBtn');\n  const soundTxt = soundBtn?.querySelector('.hdt-snd-txt');\n  if(!wrap || !vid || !handle || !soundBtn) return;\n\n  /* ---------- Autoplay (muted) = highest play rate ---------- */\n  const tryPlayMuted = async () => {\n    try {\n      vid.muted = true;\n      vid.volume = 1;\n      const p = vid.play();\n      if (p && typeof p.then === 'function') await p;\n    } catch(e) {}\n  };\n\n  /* ---------- Sound UX that makes sense ---------- */\n  const SOUND_KEY = 'hdtStickyVideoSound_pref_v3';\n\n  const syncSoundUI = () => {\n    const isMuted = vid.muted === true;\n    // If muted -> show \"Sound on\". If unmuted -> show \"Sound off\".\n    if (isMuted) {\n      wrap.classList.remove('sound-on');\n      if (soundTxt) soundTxt.textContent = 'Sound on';\n      soundBtn.setAttribute('aria-label','Turn sound on');\n    } else {\n      wrap.classList.add('sound-on');\n      if (soundTxt) soundTxt.textContent = 'Sound off';\n      soundBtn.setAttribute('aria-label','Turn sound off');\n    }\n  };\n\n  // Start muted always (because autoplay w/ sound is blocked anyway)\n  tryPlayMuted().finally(syncSoundUI);\n\n  // If user previously chose sound ON, we’ll *attempt* to enable sound\n  // on the first user interaction anywhere (tap/scroll/click) — that’s the earliest it can succeed.\n  let prefWantsSound = false;\n  try { prefWantsSound = localStorage.getItem(SOUND_KEY) === '1'; } catch(e) {}\n\n  const tryEnableSoundFromGesture = async () => {\n    if (!prefWantsSound) return;\n    if (!vid.muted) return;\n    vid.muted = false;\n    vid.volume = 1;\n    try { await vid.play(); } catch(e) {\n      // If it still fails for some reason, stay muted and keep the \"Sound on\" pill.\n      vid.muted = true;\n    }\n    syncSoundUI();\n    // run once\n    removeGestureListeners();\n  };\n\n  const addGestureListeners = () => {\n    // capture=true so we catch it early\n    window.addEventListener('pointerdown', tryEnableSoundFromGesture, {capture:true, passive:true});\n    window.addEventListener('touchstart', tryEnableSoundFromGesture, {capture:true, passive:true});\n    window.addEventListener('wheel', tryEnableSoundFromGesture, {capture:true, passive:true});\n    window.addEventListener('keydown', tryEnableSoundFromGesture, {capture:true});\n  };\n  const removeGestureListeners = () => {\n    window.removeEventListener('pointerdown', tryEnableSoundFromGesture, {capture:true});\n    window.removeEventListener('touchstart', tryEnableSoundFromGesture, {capture:true});\n    window.removeEventListener('wheel', tryEnableSoundFromGesture, {capture:true});\n    window.removeEventListener('keydown', tryEnableSoundFromGesture, {capture:true});\n  };\n  addGestureListeners();\n\n  // Button toggles sound (always works because it's a gesture)\n  soundBtn.addEventListener('click', async (e)=>{\n    e.stopPropagation();\n    if (vid.muted) {\n      vid.muted = false;\n      vid.volume = 1;\n      try { await vid.play(); } catch(_) {}\n      prefWantsSound = true;\n      try { localStorage.setItem(SOUND_KEY,'1'); } catch(_) {}\n    } else {\n      vid.muted = true;\n      prefWantsSound = false;\n      try { localStorage.setItem(SOUND_KEY,'0'); } catch(_) {}\n    }\n    syncSoundUI();\n  });\n\n  closeBtn?.addEventListener('click', ()=> wrap.remove());\n\n  /* ---------- Snap-to-sides + vertical drag (viewport-based) ---------- */\n  const POS_KEY='hdtStickyVidSnapSides_v9';\n  const clamp=(n,min,max)=>Math.max(min,Math.min(max,n));\n\n  const applyPos=(side,y)=>{\n    const pad=12;\n    const maxY=window.innerHeight - wrap.offsetHeight - 8;\n    const ty=clamp(y,8,maxY);\n\n    wrap.style.top = ty+'px';\n    wrap.style.bottom = 'auto';\n    wrap.style.transform = 'none';\n\n    wrap.style.left = 'auto';\n    wrap.style.right = 'auto';\n    if(side==='left') wrap.style.left = pad+'px';\n    else wrap.style.right = pad+'px';\n\n    try{ localStorage.setItem(POS_KEY, JSON.stringify({side,y:ty})); }catch(e){}\n  };\n\n  let side='right';\n  let y = Math.round(window.innerHeight*0.5 - wrap.offsetHeight/2);\n\n  try{\n    const p=JSON.parse(localStorage.getItem(POS_KEY)||'null');\n    if(p && (p.side==='left'||p.side==='right') && typeof p.y==='number'){\n      side=p.side; y=p.y;\n    }\n  }catch(e){}\n\n  requestAnimationFrame(()=>applyPos(side,y));\n\n  let dragging=false, startY=0, startTop=0;\n\n  const begin=(x,yc)=>{\n    dragging=true;\n    const r=wrap.getBoundingClientRect();\n    startY=yc;\n    startTop=r.top;\n    side = (x < window.innerWidth/2) ? 'left' : 'right';\n  };\n  const move=(x,yc)=>{\n    if(!dragging) return;\n    side = (x < window.innerWidth/2) ? 'left' : 'right';\n    applyPos(side, startTop + (yc - startY));\n  };\n  const end=()=> dragging=false;\n\n  [handle, grab].forEach(el=>{\n    if(!el) return;\n    el.addEventListener('mousedown', e=> begin(e.clientX, e.clientY));\n    el.addEventListener('touchstart', e=>{\n      const t=e.touches[0]; if(t) begin(t.clientX, t.clientY);\n    }, {passive:true});\n  });\n\n  window.addEventListener('mousemove', e=> move(e.clientX, e.clientY));\n  window.addEventListener('mouseup', end);\n\n  window.addEventListener('touchmove', e=>{\n    const t=e.touches[0]; if(t) move(t.clientX, t.clientY);\n  }, {passive:true});\n  window.addEventListener('touchend', end);\n\n  // do not re-anchor on scroll; only clamp on resize\n  window.addEventListener('resize', ()=> applyPos(side, y));\n})();\n</script>",
