    "accordion_JYiMAQ": {
      "type": "accordion",
      "blocks": {
        "title_KtAttM": {
          "type": "title",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "accordion_item_T9cB3Q": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the St. Patrick’s Day Flash Sale?",
            "content": "This limited-time promotion allows customers to spin the wheel to win a discount of up to 30% off on eligible Canadian Protein products."
          }
        },
        "accordion_item_g8w4wQ": {
          "type": "accordion_item",
          "settings": {
            "title": "How does the Spin to Win promotion work?",
            "content": "Spin the wheel on the promotion page to reveal your discount.\n You’ll receive a discount code that must be entered at checkout to receive your savings."
          }
        },
        "accordion_item_nW3Nnd": {
          "type": "accordion_item",
          "settings": {
            "title": "What discounts can I win?",
            "content": "You may win 10%, 15%, 20%, 25%, or 30% off your order."
          }
        },
        "accordion_item_aP9Ffw": {
          "type": "accordion_item",
          "settings": {
            "title": "Do I need a promo code?",
            "content": "Yes. The discount is applied by entering the code you receive after spinning at checkout."
          }
        },
        "accordion_item_aTG3Aq": {
          "type": "accordion_item",
          "settings": {
            "title": "Are any products excluded from the sale?",
            "content": "Most products are eligible; however, some exclusions apply, including:<br>\n- Bulk Protein<br>\n - Gift Cards<br>\n - Any items excluded at the sole discretion of Canadian Protein<br>\nSome product types may sell out or be unavailable during the sale period."
          }
        },
        "accordion_item_yjjb7Y": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How long does the Health Is Wealth Sale last?",
            "content": "The sale is valid only during the designated promotional period.\n Once the sale ends, discounts cannot be applied to past or future purchases."
          }
        },
        "accordion_item_kpRB9U": {
          "type": "accordion_item",
          "settings": {
            "title": "Will shipping times be affected?",
            "content": "At the moment, shipping times are unlikely to be affected. Should anything change, we’ll be sure to email you with an update."
          }
        },
        "accordion_item_Wn4rgx": {
          "type": "accordion_item",
          "settings": {
            "title": "What is the refund policy for sale items?",
            "content": "Refunds on sale items will be processed based on the discounted sale price, not the original full price. For more information about our refund policy, please\n  <a href=\"https://canadianprotein.com/pages/terms-and-conditions\" target=\"_blank\" rel=\"noopener noreferrer\">\n    <strong>click here</strong></a>"
          }
        },
        "accordion_item_74cqU4": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How does the “Win Your Order Refunded” promotion work?",
            "content": "During the Sale window:\n<br>\nEvery customer who places an order is automatically entered for a chance to win a refund.\n<br>\n\n - Canadian Protein will select 2 winners by random draw.\n<br>\n\n - Refund covers product value only, not shipping, taxes, or fees.\n<br>\n\n - Must be 18+ and a resident of Canada (excluding Quebec).\n<br>\n\n - Maximum refund amount is $350 CAD.\n<br>\n\n - Winners must respond within 7 days to claim their prize."
          }
        },
        "accordion_item_PmBHC7": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "How do I enter the Meta Glasses Giveaway?",
            "content": "Every order placed during the Sale counts as one automatic entry.\n One winner will receive Meta Glasses.\n The winner will be chosen by random draw and contacted by email."
          }
        },
        "accordion_item_mXh97p": {
          "type": "accordion_item",
          "disabled": true,
          "settings": {
            "title": "Should I expect delays with shipping?",
            "content": "Yes.\n Due to high order volume during the Black Friday Cyber Monday Sale, shipping delays may occur."
          }
        }
