    "accordion_FNhC6e": {
      "type": "accordion",
      "blocks": {
        "title_ey4CFh": {
          "type": "title",
          "settings": {
            "title": "How it works / Frequently asked Questions:"
          }
        },
        "accordion_item_j3jL9e": {
          "type": "accordion_item",
          "settings": {
            "title": "What is VerifyPass and how does it work on the Canadian Protein website?",
            "content": "VerifyPass is a secure, third-party verification system that confirms eligibility for exclusive discounts. Once verified, you'll instantly receive a 10% discount code to use at checkout on CanadianProtein.com. This offer is available for eligible groups such as students, teachers, first responders, and more."
          }
        },
        "accordion_item_jyVYgb": {
          "type": "accordion_item",
          "settings": {
            "title": "Who qualifies for a VerifyPass discount?",
            "content": "Eligible groups include:\n<br>\n<br>\n<b>\n- Students<br>\n- First Responders<br>\n- Military (active duty, veterans, and retirees)<br>\n- Healthcare Workers<br>\n- Teachers<br>\n- Government Workers<br>\n- Seniors (60+)<br>\n</b>\n<br>\nYou must verify your status through the VerifyPass widget to access the discount."
          }
        },
        "accordion_item_f7MBMg": {
          "type": "accordion_item",
          "settings": {
            "title": "What discount do I receive with VerifyPass?",
            "content": "Verified individuals receive an exclusive 10% discount on their Canadian Protein order. This discount is accessible once per day per user. Some exclusions may apply."
          }
        },
        "accordion_item_AMhFqb": {
          "type": "accordion_item",
          "settings": {
            "title": "How often can I use the VerifyPass discount?",
            "content": "You can redeem a VerifyPass discount once every 24 hours. If you’ve already claimed your code for the day, please return tomorrow to request another."
          }
        },
        "accordion_item_YzyF8Y": {
          "type": "accordion_item",
          "settings": {
            "title": "Can the VerifyPass discount be combined with other promotions or site-wide sales?",
            "content": "It varies. In some cases, the 10% VerifyPass discount can be combined with other promotions running on the Canadian Protein website. In other cases, it may not stack with additional discounts. You’ll see a notice at checkout if the combination isn’t allowed."
          }
        },
        "accordion_item_aNC8qn": {
          "type": "accordion_item",
          "settings": {
            "title": "Is there a limit to how many times I can use the discount?",
            "content": "There is a limit of one discount code per applicant and can use the discount as often as you’d like — one use per 24 hours."
          }
        },
        "accordion_item_r3T4Jf": {
          "type": "accordion_item",
          "settings": {
            "title": "Are any products excluded from the VerifyPass discount?",
            "content": "<p>\n      Yes. While we’re proud to offer exclusive discounts to verified members through VerifyPass, <strong>some products are excluded</strong> from eligibility due to pricing structures or fulfillment limitations.\n    </p>\n<br>\n    <p>The following <strong>are not eligible</strong> for VerifyPass discounts (subject to change):</p>\n    <ul style=\"margin-left: 1.25rem; list-style: disc;\">\n      <li>\n<strong>All Bulk Protein Products</strong> (including all multi-kilo or case-size protein items)</li>\n      <li>\n<strong>Gift Cards</strong> (digital or physical)</li>\n      <li>\n<strong>Subscription Orders</strong> (including auto-renewing plans)</li>\n    </ul><br>\n    <p>\n      At times, additional exclusions may apply depending on promotional offers or inventory changes.\n      VerifyPass discounts <strong>cannot be combined</strong> with other promotions unless explicitly stated.\n    </p>"
          }
        },
        "accordion_item_6q6dDm": {
          "type": "accordion_item",
          "settings": {
            "title": "My code isn’t working — what should I do?",
            "content": "If your VerifyPass code isn’t applying at checkout:<br>\n<br>\n- Confirm that it hasn’t expired (codes are time-sensitive).<br>\n- Check whether it conflicts with another site-wide promotion.<br>\n- Make sure you're using it within 24 hours of last redemption.<br>\n<br>\nStill having trouble? Please contact Canadian Protein Customer Support or reach out to VerifyPass directly for help at help@verifypass.com."
          }
        }
      },
