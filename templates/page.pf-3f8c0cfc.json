        "pf_fc8e5c94_value": "<span style=\"color: rgb(0, 186, 219);\"></span>3rd Place - <span style=\"color: rgb(255, 29, 90);\"><span style=\"color: rgb(0, 186, 219);\">$50</span></span>",
        "pf_6e016f6f_value": "The announcement of the winners will be made through our various social media platforms, our newsletter, and prominently displayed on this page.",
