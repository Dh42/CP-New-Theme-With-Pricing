            "custom_liquid": "<div id=\"suggested-container\">\n  {% assign suggested_info = product.metafields.nutrify_nutrition_info.nutrify_nutrition_info_product%}\n  {% if suggested_info %}\n    {% assign suggested_data = suggested_info.value | json_parse %}\n    {% if suggested_data.suggested != blank %}\n      <div class=\"suggested-info\">\n        <h2>{{ block.settings.suggested_title }}</h2>\n        <p>{{ suggested_data.suggested }}</p>\n      </div>\n    {% endif %}\n  {% endif %}\n</div>"
