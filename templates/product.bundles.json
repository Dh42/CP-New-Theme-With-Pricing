        "tab_liquid_h6jD6n": {
          "type": "tab_liquid",
          "disabled": true,
          "settings": {
            "title": "Ingredients",
            "custom_liquid": "{%-  assign selected_variant = product.selected_or_first_available_variant -%}\n{%- for variant in product.metafields.canadian_info.canadian_info_product.value.variants -%}\n{% if selected_variant.option2%}\n  {%-  assign selected_variant_title= selected_variant.option2| replace: \"&\", \"and\" -%}\n{% else %}\n  {%-  assign selected_variant_title= selected_variant.option1| replace: \"&\", \"and\" -%}\n{% endif %}\n\n              {%-if variant[1].title == selected_variant_title -%}\n              <div data-option=\"{{variant[0]}}\" id=\"variantBoxDefault\" class=\"variantBox\">\n                <h4>Ingredients for  {{variant[0]}}</h4>\n                \t{{variant[1].ingredients}}\n              </div>\n              {%- else -%}\n                  <div data-option=\"{{variant[0]}}\"{% if selected_variant != variant %} style=\"display:none\"{% endif %} class=\"variantBox\">\n                    <h4>Ingredients for  {{variant[0]}}</h4>\n                \t{{variant[1].ingredients}}\n\n                </div>\n                {%- endif -%}\n                {%- endfor -%}"
          }
        },
        "tab_liquid_w6rHMR": {
          "type": "tab_liquid",
          "settings": {
            "title": "Ingredients",
            "custom_liquid": "{{ 'nutrition_facts.css' | asset_url | stylesheet_tag }}\n\n<div id=\"ingredients-container\">\n{% assign default_variant = nil %}\n{% for variant in product.variants %}\n  {% assign variant_nutrition = variant.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant %}\n  {% if variant_nutrition.value.isDefault %}\n    {% assign default_variant = variant %}\n    {% break %}\n  {% endif %}\n{% endfor %}\n\n{% for variant in product.variants %}\n  {% assign variant_nutrition = variant.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant %}\n  {% if variant_nutrition %}\n    {% assign nutrition = variant_nutrition.value %}\n    {% if nutrition.ingredients %}\n      <div class=\"ingredients-info\" data-variant-id=\"{{ variant.id }}\" {% if variant.id == default_variant.id or default_variant == nil and forloop.first %}style=\"display: block;\"{% else %}style=\"display: none;\"{% endif %}>\n        <h2>{{ block.settings.ingredients_title }}</h2>\n        <p>{{ nutrition.ingredients }}</p>\n      </div>\n    {% endif %}\n  {% endif %}\n{% endfor %}\n</div>\n\n<script>\n  // Initialize with the first available variant\n  window.initialIngredientVariant = {{ product.selected_or_first_available_variant | json }};\n\n  class IngredientsInfo {\n    constructor() {\n      this.container = document.getElementById('ingredients-container');\n      this.ingredientsContainers = this.container.querySelectorAll('.ingredients-info');\n      this.mainProductForm = document.querySelector('form[action=\"/cart/add\"]');\n      this.variantSelector = null;\n      this.hasDefaultVariant = {{ default_variant | json }} !== null;\n\n      this.init();\n    }\n\n    init() {\n      if (!this.mainProductForm || this.hasDefaultVariant) return;\n\n      // Try to find the variant selector\n      this.variantSelector = this.mainProductForm.querySelector('[name=\"id\"]');\n\n      if (!this.variantSelector) {\n        // If we can't find a direct variant selector, look for radio buttons\n        const radioButtons = this.mainProductForm.querySelectorAll('input[type=\"radio\"][name=\"id\"]');\n        if (radioButtons.length > 0) {\n          this.variantSelector = radioButtons;\n        }\n      }\n\n      if (this.variantSelector) {\n        // Initial update with the first available variant\n        this.updateIngredients(window.initialIngredientVariant.id.toString());\n\n        // Listen for changes\n        if (Array.isArray(this.variantSelector)) {\n          this.variantSelector.forEach(radio => {\n            radio.addEventListener('change', () => this.updateIngredients());\n          });\n        } else {\n          this.variantSelector.addEventListener('change', () => this.updateIngredients());\n        }\n      }\n    }\n\n    updateIngredients(initialVariantId = null) {\n      if (this.hasDefaultVariant) return;\n\n      let selectedVariantId;\n\n      if (initialVariantId) {\n        selectedVariantId = initialVariantId;\n      } else if (Array.isArray(this.variantSelector)) {\n        // For radio buttons\n        const checkedRadio = Array.from(this.variantSelector).find(radio => radio.checked);\n        selectedVariantId = checkedRadio ? checkedRadio.value : null;\n      } else {\n        // For dropdown\n        selectedVariantId = this.variantSelector.value;\n      }\n\n      if (selectedVariantId) {\n        this.ingredientsContainers.forEach(container => {\n          if (container.getAttribute('data-variant-id') === selectedVariantId) {\n            container.style.display = 'block';\n          } else {\n            container.style.display = 'none';\n          }\n        });\n      }\n    }\n  }\n\n  // Initialize the IngredientsInfo class when the DOM is ready\n  document.addEventListener('DOMContentLoaded', () => {\n    new IngredientsInfo();\n  });\n</script>"
          }
        },
        "tab_liquid_jLQjRw": {
          "type": "tab_liquid",
          "settings": {
            "title": "Nutrition Facts",
            "custom_liquid": "{{ 'nutrition_facts.css' | asset_url | stylesheet_tag }}\n\n<div id=\"nutrition-facts-container\">\n{% assign default_variant = nil %}\n{% for variant in product.variants %}\n  {% assign variant_nutrition = variant.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant %}\n  {% if variant_nutrition.value.isDefault %}\n    {% assign default_variant = variant %}\n    {% break %}\n  {% endif %}\n{% endfor %}\n\n\n{% assign config = shop.metafields.nutrify_nutrition_info.nutrify_nutrition_info_config.value %}\n\n{% for variant in product.variants %}\n  {% assign variant_nutrition = variant.metafields.nutrify_nutrition_info.nutrify_nutrition_info_variant %}\n  {% if variant_nutrition %}\n    {% assign nutrition = variant_nutrition.value %}\n    <section class=\"performance-facts\" data-variant-id=\"{{ variant.id }}\" {% if variant.id == default_variant.id or default_variant == nil and forloop.first %}style=\"display: block;\"{% else %}style=\"display: none;\"{% endif %}>\n      <header class=\"performance-facts__header\">\n        <h1 class=\"performance-facts__title\">Nutrition Facts</h1>\n        <p>Serving Size {{ nutrition.ssize }}</p>\n        <p>Servings Per Container {{ nutrition.servingsPerContainer }}</p>\n      </header>\n      <table class=\"performance-facts__table\">\n        <thead>\n          <tr>\n            <th colspan=\"3\" class=\"small-info\">\n              Amount Per Serving\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th colspan=\"2\">\n              <b>Calories</b>\n              {{ nutrition.cal }}\n            </th>\n            <!--<td>\n              {% if nutrition.calFromFat %}\n                Calories from Fat\n                {{ nutrition.calFromFat }}\n              {% endif %}\n            </td>-->\n          </tr>\n          <tr class=\"thick-row\">\n            <td colspan=\"3\" class=\"small-info\">\n              <b>% Daily Value*</b>\n            </td>\n          </tr>\n          {% for item in nutrition %}\n            {% assign item_key = item[0] %}\n            {% assign item_value = item[1] %}\n            {% assign dv_key = item_key | append: 'DV' %}\n            {% assign dv_value = nutrition[dv_key] %}\n            {% case item_key %}\n              {% when 'fat', 'cholesterol', 'sodium', 'carbs', 'protein' %}\n                <tr{% if item_key == 'protein' %} class=\"thick-end\"{% endif %}>\n                  <th colspan=\"2\">\n                    <b>\n                      {% case item_key %}\n                        {% when 'fat' %}Total Fat\n                        {% when 'cholesterol' %}Cholesterol\n                        {% when 'sodium' %}Sodium\n                        {% when 'carbs' %}Total Carbohydrate\n                        {% when 'protein' %}Protein\n                      {% endcase %}\n                    </b>\n                    {{ item_value }}{% if item_key == 'sodium' or item_key == 'cholesterol' %}mg{% else %}g{% endif %}\n                  </th>\n                  <td>\n                    {% if config.dailyValues[item_key] != '' and config.dailyValues[item_key] != '0' %}\n                      {% assign dv_value = nutrition[item_key] | times: 100.0 | divided_by: config.dailyValues[item_key] | round: 1 %}\n                      {% if dv_value > 0 and dv_value != 'Infinity' %}<b>{{ dv_value }}%</b>{% endif %}\n                    {% endif %}\n                  </td>\n                </tr>\n                {% if item_key == 'fat' %}\n                  {% for subitem in nutrition %}\n                    {% if subitem[0] == 'satfat' or subitem[0] == 'tfat' or subitem[0] == 'usatfat' %}\n                      <tr>\n                        <td class=\"blank-cell\">\n                        </td>\n                        <th>\n                          {% case subitem[0] %}\n                            {% when 'satfat' %}Saturated Fat\n                            {% when 'tfat' %}Trans Fat\n                            {% when 'usatfat' %}Unsaturated Fat\n                          {% endcase %}\n                          {{ subitem[1] }}g\n                        </th>\n                        <td>\n                          {% assign dv = config.dailyValues[subitem[0]] | times: 1 %}\n                          {% if dv > 0 and dv != blank %}\n                            {% assign dv_value = nutrition[subitem[0]] | times: 100.0 | divided_by: dv | round: 1 %}\n                            {% if dv_value > 0 %}<b>{{ dv_value }}%</b>{% endif %}\n                          {% endif %}\n                        </td>\n                      </tr>\n                    {% endif %}\n                  {% endfor %}\n                {% endif %}\n                {% if item_key == 'carbs' %}\n                  {% for subitem in nutrition %}\n                    {% if subitem[0] == 'fiber' or subitem[0] == 'sugar' %}\n                      <tr>\n                        <td class=\"blank-cell\">\n                        </td>\n                        <th>\n                          {% case subitem[0] %}\n                            {% when 'fiber' %}Dietary Fiber\n                            {% when 'sugar' %}Sugars\n                          {% endcase %}\n                          {{ subitem[1] }}g\n                        </th>\n                        <td>\n                          {% assign daily_value = config.dailyValues[subitem[0]] | times: 1 %}\n                          {% if daily_value > 0 %}\n                            {% assign dv_value = nutrition[subitem[0]] | times: 100.0 | divided_by: daily_value | round: 1 %}\n                            {% if dv_value > 0 %}<b>{{ dv_value }}%</b>{% endif %}\n                          {% endif %}\n                      </tr>\n                    {% endif %}\n                  {% endfor %}\n                {% endif %}\n            {% endcase %}\n          {% endfor %}\n          {% for item in config.customFields %}\n            {% if nutrition.customFields[item.name] != blank %}\n            <tr class=\"{% if forloop.last %}thick-end{% else %}thin-end{% endif %}\">\n              <th colspan=\"2\">\n                {{ item.name }}\n\n                  {{ nutrition.customFields[item.name] }}{% if item.unit != blank %}{{ item.unit }}{% endif %}\n\n              </th>\n              <td>\n\n                  {% if item.dailyValue > 0 %}\n                    {% assign dv_value = nutrition.customFields[item.name] | times: 100.0 | divided_by: item.dailyValue | round: 1 %}\n                    {% if dv_value > 0 %}{{ dv_value }}%{% endif %}\n                  {% endif %}\n              </td>\n            {% endif %}\n            </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n\n\n\n      <p class=\"daily-value-note\">* Percent Daily Values are based on a 2,000 calorie diet. Your daily values may be higher or lower depending on your calorie needs:</p>\n    </section>\n  {% else %}\n    <section class=\"performance-facts\" data-variant-id=\"{{ variant.id }}\" style=\"display: none;\">\n      <p>No nutrition information available for this variant.</p>\n    </section>\n  {% endif %}\n{% endfor %}\n</div>\n\n<script>\n  // Initialize with the first available variant\n  window.initialNutritionVariant = {{ product.selected_or_first_available_variant | json }};\n\n  class NutritionFacts {\n    constructor() {\n      this.container = document.getElementById('nutrition-facts-container');\n      this.nutritionContainers = this.container.querySelectorAll('.performance-facts');\n      this.mainProductForm = document.querySelector('form[action$=\"/cart/add\"]');\n      this.variantSelector = null;\n      this.hasDefaultVariant = {{ default_variant | json }} !== null;\n\n      this.init();\n    }\n\n    init() {\n\n      if (!this.mainProductForm || this.hasDefaultVariant) return;\n\n      // Try to find the variant selector\n      this.variantSelector = this.mainProductForm.querySelector('[name=\"id\"]');\n\n      if (!this.variantSelector) {\n        // If we can't find a direct variant selector, look for radio buttons\n        const radioButtons = this.mainProductForm.querySelectorAll('input[type=\"radio\"][name=\"id\"]');\n        if (radioButtons.length > 0) {\n          this.variantSelector = radioButtons;\n        }\n      }\n\n      if (this.variantSelector) {\n        // Initial update with the first available variant\n        this.updateNutritionFacts(window.initialNutritionVariant.id.toString());\n\n        // Listen for changes\n        if (Array.isArray(this.variantSelector)) {\n          this.variantSelector.forEach(radio => {\n            radio.addEventListener('change', () => this.updateNutritionFacts());\n          });\n        } else {\n          this.variantSelector.addEventListener('change', () => this.updateNutritionFacts());\n        }\n      }\n    }\n\n    updateNutritionFacts(initialVariantId = null) {\n      if (this.hasDefaultVariant) return;\n\n      let selectedVariantId;\n\n      if (initialVariantId) {\n        selectedVariantId = initialVariantId;\n      } else if (Array.isArray(this.variantSelector)) {\n        // For radio buttons\n        const checkedRadio = Array.from(this.variantSelector).find(radio => radio.checked);\n        selectedVariantId = checkedRadio ? checkedRadio.value : null;\n      } else {\n        // For dropdown\n        selectedVariantId = this.variantSelector.value;\n      }\n\n      if (selectedVariantId) {\n        this.nutritionContainers.forEach(container => {\n          if (container.getAttribute('data-variant-id') === selectedVariantId) {\n            container.style.display = 'block';\n          } else {\n            container.style.display = 'none';\n          }\n        });\n      }\n    }\n  }\n\n  // Initialize the NutritionFacts class when the DOM is ready\n  document.addEventListener('DOMContentLoaded', () => {\n    new NutritionFacts();\n  });\n</script>"
          }
        },
